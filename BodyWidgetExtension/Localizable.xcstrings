    "Chart a metric's weekly or monthly trend.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Wochen- oder Monatstrend eines Messwerts als Diagramm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chart a metric's weekly or monthly trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la tendencia semanal o mensual de una métrica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez la tendance hebdomadaire ou mensuelle d’une mesure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी मेट्रिक का साप्ताहिक या मासिक ट्रेंड चार्ट में देखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "График тренда показателя за неделю или месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ölçümün haftalık veya aylık eğilimini grafikte görün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看某项指标的周趋势或月趋势。"
          }
        }
      }
    },
