    "onboarding.calendar.switch.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe im Kalender auf die Diagrammtaste, um den Monat nach Aktivität zu ordnen, und dann auf die Rastertaste neben dem letzten Balken, um zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the chart button in the calendar to rank the month by activity, then the grid button next to the last bar to come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón de gráfica del calendario para ordenar el mes por actividad y luego el botón de cuadrícula junto a la última barra para volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton du graphique dans le calendrier pour classer le mois par activité, puis le bouton de grille à côté de la dernière barre pour revenir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महीने को ऐक्टिविटी के हिसाब से रैंक करने के लिए कैलेंडर में चार्ट बटन पर टैप करें, फिर वापस आने के लिए आख़िरी पट्टी के बग़ल वाले ग्रिड बटन पर टैप करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь кнопки графика в календаре, чтобы упорядочить месяц по видам активности, а затем кнопки сетки рядом с последним столбцом, чтобы вернуться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
