    "Health access was denied. Review Body's permissions in Apple Health or iOS Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf Health wurde abgelehnt. Prüfe die Berechtigungen von Body in Health oder in den iOS-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health access was denied. Review Body's permissions in Apple Health or iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso a Salud. Revisa los permisos de Body en la app Salud o en Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à Santé a été refusé. Vérifiez les autorisations de Body dans l’app Santé ou dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेहत ऐक्सेस अस्वीकार कर दी गई। सेहत ऐप या iOS सेटिंग में Body की अनुमतियाँ देखें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к приложению «Здоровье» запрещен. Проверьте права доступа Body в приложении «Здоровье» или в Настройках iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlık erişimi reddedildi. Body'nin izinlerini Sağlık uygulamasında veya iOS Ayarlar'ında gözden geçirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康访问权限被拒绝。请在健康 App 或 iOS 设置中查看 Body 的权限。"
          }
        }
      }
    },
