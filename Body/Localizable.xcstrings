    "Billing starts at %@. Cancel at least 24 hours before and you won't be charged." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab dann zahlst du %@. Kündige mindestens 24 Stunden vorher, dann wird dir nichts berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billing starts at %@. Cancel at least 24 hours before and you won't be charged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La facturación empieza el %@. Cancela al menos 24 horas antes y no se te cobrará nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La facturation commence le %@. Annulez au moins 24 heures avant pour éviter toute facturation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिलिंग %@ से शुरू होगी। अगर आप कम से कम 24 घंटे पहले रद्द कर देते हैं, तो आपसे शुल्क नहीं लिया जाएगा।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Списание начнется: %@. Отмените подписку не позднее чем за 24 часа, и плата не будет взиматься."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeme %@ tarihinde başlar. En az 24 saat önce iptal ederseniz ücret alınmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "届时开始扣费，%@。至少提前 24 小时取消即不会扣费。"
          }
        }
      }
    },
