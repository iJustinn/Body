    "bodyRadar.chart.bandsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei gestapelte Bänder: oben rot für deutliche Anzeichen, in der Mitte rosa für leichte Anzeichen und unten ohne Farbe für keine Anzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three stacked bands, tinted red for Major on top, pink for Minor in the middle, and plain for No signs at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres franjas apiladas: roja arriba para Claras, rosa en el medio para Leves y sin color abajo para Sin señales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois bandes superposées : rouge en haut pour « Marqué », rose au milieu pour « Léger » et neutre en bas pour « Aucun signe »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक के ऊपर एक तीन बैंड: सबसे ऊपर प्रबल संकेत के लिए लाल, बीच में हल्के संकेत के लिए गुलाबी, और सबसे नीचे कोई संकेत नहीं के लिए बिना रंग का।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три полосы друг над другом: красная сверху для сильных признаков, розовая посередине для слабых признаков и бесцветная внизу для отсутствия признаков."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üst üste üç aralık: en üstte Belirgin için kırmızı, ortada Hafif için pembe, en altta Belirti Yok için renksiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三条堆叠色带，顶部红色为明显迹象，中间粉色为轻微迹象，底部无色为无迹象。"
          }
        }
      }
    },
