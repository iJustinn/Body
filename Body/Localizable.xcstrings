        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी रंग को स्पेक्ट्रम पर ड्रैग करके उसका रंग बदलें, या प्रीव्यू पर किसी डिवाइडर को ड्रैग करके तय करें कि हर रंग कितनी जगह ले।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните цвет по спектру, чтобы изменить его, или перетяните разделитель на превью, чтобы изменить долю каждого цвета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir rengi değiştirmek için onu spektrum üzerinde sürükleyin veya her rengin kapladığı alanı değiştirmek için önizlemedeki bir ayırıcıyı sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
