    "onboarding.readiness.signals.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body vergleicht deine jüngsten Herz-, Schlaf- und Trainingsdaten sowie deine nächtlichen Vitalzeichen mit dem, was für dich normal ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body compares your recent heart, sleep, training, and overnight vital signs against what is normal for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body compara tus datos recientes de corazón, sueño, entrenamiento y signos vitales nocturnos con lo que es normal para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body compare vos données récentes de cœur, de sommeil, d’entraînement et de signes vitaux nocturnes à ce qui est normal pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body आपके हाल के हृदय, नींद, ट्रेनिंग और रात के वाइटल साइन की तुलना उससे करता है जो आपके लिए सामान्य है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body сравнивает недавние данные о сердце, сне, тренировках и ночных основных показателях с тем, что нормально именно для Вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body, yakın zamandaki kalp, uyku ve antrenman verilerinizi ve gece boyu ölçülen yaşam bulgularınızı sizin için normal olanla karşılaştırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会将您近期的心脏、睡眠、训练和夜间体征数据与您自己的常态进行对比。"
          }
        }
      }
    },
    "onboarding.readiness.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zahl an jedem Morgen dafür, wie erholt dein Körper ist. Sie ist eine Schätzung, keine Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One number each morning for how recovered your body is. It is an estimate, not a diagnosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un número cada mañana que indica lo recuperado que está tu cuerpo. Es una estimación, no un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chiffre chaque matin pour savoir à quel point votre corps a récupéré. C’est une estimation, pas un diagnostic."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सुबह एक संख्या, जो बताती है कि आपका शरीर कितना रिकवर हुआ है। यह एक अनुमान है, निदान नहीं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно число каждое утро о том, насколько восстановился Ваш организм. Это оценка, а не диагноз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sabah vücudunuzun ne kadar toparlandığını gösteren tek bir sayı. Bu bir tahmindir, teşhis değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天早晨用一个数字反映身体的恢复程度。它只是一个估算，并非医学诊断。"
          }
        }
      }
    },
