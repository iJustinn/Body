    "notifications.timing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundprüfungen folgen dem Zeitplan des Systems. Stresshinweise melden neue Phasen mit hohem Stress, höchstens einmal pro Prüfung. Trainingshinweise kommen nach der Synchronisierung. Messwertwarnungen erscheinen einmal pro Art und Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background checks follow the system’s schedule. Stress alerts report new high-stress episodes, at most once per check. Workout alerts arrive after syncing. Metric warnings notify once per kind each day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comprobaciones en segundo plano siguen la programación del sistema. Las alertas de estrés informan de nuevos episodios de estrés alto, como máximo una vez por comprobación. Las alertas de entrenamiento llegan después de sincronizar. Los avisos de métricas se envían una vez al día por cada tipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vérifications en arrière-plan suivent le calendrier du système. Les alertes de stress signalent les nouveaux épisodes de stress élevé, au plus une fois par vérification. Les alertes d’exercice arrivent après la synchronisation. Les avertissements de mesures sont envoyés une fois par type et par jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकग्राउंड जाँच सिस्टम के शेड्यूल के अनुसार होती है। तनाव अलर्ट ज़्यादा तनाव के नए दौर बताते हैं, हर जाँच में ज़्यादा से ज़्यादा एक बार। वर्कआउट अलर्ट सिंक होने के बाद आते हैं। मेट्रिक चेतावनियाँ हर प्रकार के लिए दिन में एक बार आती हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновые проверки выполняются по расписанию системы. Уведомления о стрессе сообщают о новых периодах высокого стресса, не чаще одного раза за проверку. Уведомления о тренировках приходят после синхронизации. Предупреждения о показателях приходят не чаще одного раза в день для каждого вида."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan denetimleri sistemin zamanlamasına göre çalışır. Stres uyarıları yeni yüksek stres dönemlerini her denetimde en fazla bir kez bildirir. Antrenman uyarıları eşzamanlamadan sonra gelir. Ölçüm uyarıları her tür için günde bir kez bildirilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台检查由系统安排。压力通知报告新的高压力时段，每次检查最多一次。运动通知在同步后发送。每种指标预警每天最多通知一次。"
          }
        }
      }
    },
    "notifications.warnings" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messwertwarnungen"
