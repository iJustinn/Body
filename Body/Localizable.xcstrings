      }
    },
    "notifications.warnings.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Mitteilung, wenn ein Messwert an einem Tag zum ersten Mal eine deiner Warnschwellen überschreitet, etwa bei niedriger Herzfrequenz oder niedrigem Blutsauerstoff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified the first time a day a metric crosses one of your warning thresholds, such as low heart rate or low blood oxygen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso la primera vez en el día que una métrica cruce uno de tus umbrales de aviso, como frecuencia cardiaca baja u oxígeno en sangre bajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification la première fois dans la journée qu’une mesure franchit l’un de vos seuils d’avertissement, comme une fréquence cardiaque faible ou un oxygène sanguin faible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई मेट्रिक दिन में पहली बार आपकी किसी चेतावनी सीमा को पार करे, जैसे निम्न हृदय गति या निम्न रक्त ऑक्सीजन, तब सूचना पाएँ।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомление, когда показатель впервые за день выходит за один из Ваших порогов предупреждения, например при низком пульсе или низком уровне кислорода в крови."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ölçüm, düşük kalp atış hızı veya düşük kanda oksijen düzeyi gibi uyarı eşiklerinizden birini gün içinde ilk kez aştığında bildirim alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当指标当天首次超出您设定的预警阈值时通知您，例如心率过低或血氧过低。"
          }
        }
      }
    },
