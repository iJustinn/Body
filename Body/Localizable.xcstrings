            "value" : "Two stars mean two workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos estrellas son dos entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux étoiles valent deux exercices."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
