    "Drag a color around the spectrum to recolor it, or drag a divider on the preview to change how much space each color takes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe eine Farbe über das Spektrum, um sie umzufärben, oder ziehe eine Trennlinie in der Vorschau, um festzulegen, wie viel Platz jede Farbe einnimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a color around the spectrum to recolor it, or drag a divider on the preview to change how much space each color takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un color por el espectro para cambiarlo, o arrastra un divisor en la vista previa para cambiar cuánto espacio ocupa cada color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une couleur sur le spectre pour la modifier, ou faites glisser un séparateur sur l’aperçu pour changer l’espace occupé par chaque couleur."
          }
