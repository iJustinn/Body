    "onboarding.calendar.share.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ein Training und tippe auf „Teilen“, um eine Karte mit deiner Route und deinen Werten zu erstellen. Sichere sie oder sende sie, wohin du willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open any workout and tap Share to create a card with your route and stats, then save it or send it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un entrenamiento y toca Compartir para crear una tarjeta con tu ruta y tus estadísticas, y luego guárdala o envíala a donde quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un exercice et touchez « Partager » pour créer une carte avec votre parcours et vos statistiques, puis enregistrez-la ou envoyez-la où vous voulez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी वर्कआउट खोलें और शेयर करें पर टैप करें, इससे आपके मार्ग और आँकड़ों वाला कार्ड बन जाएगा, फिर उसे सहेजें या कहीं भी भेजें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте любую тренировку и коснитесь «Поделиться», чтобы создать карточку с маршрутом и показателями, затем сохраните ее или отправьте куда угодно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotanızı ve istatistiklerinizi içeren bir kart oluşturmak için herhangi bir antrenmanı açıp Paylaş'a dokunun, ardından kartı kaydedin veya istediğiniz yere gönderin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开任意运动并点按“分享”，即可生成包含路线和数据的卡片，保存或发送到任何地方。"
          }
        }
      }
    },
