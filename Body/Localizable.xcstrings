      }
    },
    "Applies in Settings when you pick a unit, a Home Hero, a route style, or an app icon, and on Summary when you drag a card to a new spot and drop it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt in den Einstellungen, wenn du eine Einheit, eine Hauptkarte, einen Routenstil oder ein App-Symbol auswählst, und in der Übersicht, wenn du eine Karte an eine neue Stelle ziehst und loslässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies in Settings when you pick a unit, a Home Hero, a route style, or an app icon, and on Summary when you drag a card to a new spot and drop it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica en Ajustes al elegir una unidad, una portada, un estilo de ruta o un icono de la app, y en Resumen al arrastrar una tarjeta a otro lugar y soltarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique dans Réglages lorsque vous choisissez une unité, une carte principale, un style de parcours ou une icône d’app, et dans Résumé lorsque vous faites glisser une carte vers un nouvel emplacement et la déposez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग में इकाई, होम हीरो, मार्ग स्टाइल या ऐप आइकॉन चुनने पर, और सारांश पर किसी कार्ड को नई जगह खींचकर छोड़ने पर लागू होता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется в Настройках при выборе единиц, главной карточки, стиля маршрута или значка приложения, а также в «Сводке», когда Вы перетаскиваете карточку на новое место и отпускаете ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar'da bir birim, Ana Gösterge, rota stili veya uygulama simgesi seçtiğinizde ve Özet'te bir kartı yeni bir yere sürükleyip bıraktığınızda geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于设置中选择单位、首页主视图、路线样式或应用图标时，以及在概览页将卡片拖到新位置并放下时。"
          }
        }
      }
    },
    "Applies on Workouts when the month changes: a swipe or a tap on the month bar, a swipe across the chart, a triple tap back to this month, and Go to Month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt in „Trainings“, wenn der Monat wechselt: Streichen oder Tippen auf der Monatsleiste, Streichen über das Diagramm, dreifaches Tippen zurück zum aktuellen Monat und „Zum Monat“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies on Workouts when the month changes: a swipe or a tap on the month bar, a swipe across the chart, a triple tap back to this month, and Go to Month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica en Entrenamientos al cambiar de mes: al deslizar o tocar la barra de meses, al deslizar sobre la gráfica, al tocar tres veces para volver a este mes y con Ir al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique dans Exercices lorsque le mois change : un balayage ou un toucher sur la barre des mois, un balayage sur le graphique, un triple toucher pour revenir au mois en cours, et « Aller au mois »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कआउट पर महीना बदलने पर लागू होता है: महीने की पट्टी पर स्वाइप या टैप, चार्ट पर स्वाइप, इस महीने पर लौटने के लिए तीन बार टैप, और “महीने पर जाएँ”।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется в «Тренировках» при смене месяца: смахивание или касание панели месяца, смахивание по графику, тройное касание для возврата к текущему месяцу и «Перейти к месяцу»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanlar'da ay değiştiğinde geçerlidir: ay çubuğunda kaydırma veya dokunma, grafik boyunca kaydırma, bu aya dönmek için üç kez dokunma ve Aya Git."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于体能训练页的月份变化：在月份栏上轻扫或轻点、在图表上轻扫、轻点三下回到本月，以及“前往该月”。"
          }
        }
      }
    },
    "Applies to the bar at the bottom of the screen. Off by default, so the bar shows only the Summary, Workouts, and Settings icons. Names appear right away when you turn this on, but because of a system limitation they can stay visible after you turn it off until Body restarts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für die Leiste am unteren Bildschirmrand. Standardmäßig deaktiviert, sodass die Leiste nur die Symbole für Übersicht, Trainings und Einstellungen zeigt. Die Namen erscheinen sofort, wenn du die Option aktivierst. Wegen einer Systemeinschränkung können sie nach dem Deaktivieren aber sichtbar bleiben, bis Body neu startet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the bar at the bottom of the screen. Off by default, so the bar shows only the Summary, Workouts, and Settings icons. Names appear right away when you turn this on, but because of a system limitation they can stay visible after you turn it off until Body restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la barra de la parte inferior de la pantalla. Está desactivado de forma predeterminada, así que la barra solo muestra los iconos de Resumen, Entrenamientos y Ajustes. Los nombres aparecen en cuanto lo activas, pero, por una limitación del sistema, pueden seguir visibles después de desactivarlo hasta que Body se reinicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à la barre en bas de l’écran. Cette option est désactivée par défaut : la barre n’affiche alors que les icônes Résumé, Exercices et Réglages. Les noms apparaissent dès que vous l’activez, mais en raison d’une limitation du système, ils peuvent rester visibles après sa désactivation jusqu’au redémarrage de Body."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के नीचे वाली पट्टी पर लागू होता है। यह डिफ़ॉल्ट रूप से बंद रहता है, इसलिए पट्टी में सिर्फ़ सारांश, वर्कआउट और सेटिंग के आइकॉन दिखते हैं। इसे चालू करते ही नाम दिखने लगते हैं, लेकिन सिस्टम की एक सीमा के कारण इसे बंद करने के बाद भी वे Body के दोबारा शुरू होने तक दिख सकते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется к панели внизу экрана. По умолчанию выключено, поэтому на панели видны только значки «Сводка», «Тренировки» и «Настройки». Названия появляются сразу после включения, но из-за ограничения системы после выключения они могут оставаться на экране до перезапуска Body."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın altındaki çubuk için geçerlidir. Varsayılan olarak kapalıdır, bu nedenle çubukta yalnızca Özet, Antrenmanlar ve Ayarlar simgeleri görünür. Bunu açtığınızda adlar hemen görünür, ancak bir sistem sınırlaması nedeniyle kapattıktan sonra Body yeniden başlayana kadar görünür kalabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于屏幕底部的导航栏。默认关闭，导航栏只显示概览、体能训练和设置的图标。开启后名称会立即显示，但受系统限制，关闭后名称可能会保留，直到 Body 重新启动。"
          }
        }
      }
    },
    "Applies to the Equivalent card on a workout's detail page: a soft tap whenever two foods collide. Turn it off if you'd rather the card stay silent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für die Gegenwert-Karte auf der Detailseite eines Trainings: ein sanftes Tippen, wann immer zwei Lebensmittel zusammenstoßen. Deaktiviere die Option, wenn die Karte lieber still bleiben soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the Equivalent card on a workout's detail page: a soft tap whenever two foods collide. Turn it off if you'd rather the card stay silent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la tarjeta de equivalencia en la página de detalles de un entrenamiento: un toque suave cada vez que chocan dos alimentos. Desactívalo si prefieres que la tarjeta no vibre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à la carte Équivalent sur la page de détail d’un exercice : une légère vibration chaque fois que deux aliments se heurtent. Désactivez cette option si vous préférez que la carte reste silencieuse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कआउट के विवरण पेज पर समतुल्य कार्ड पर लागू होता है: जब भी दो खाने की चीज़ें टकराती हैं, एक हल्का टैप महसूस होता है। अगर आप चाहते हैं कि कार्ड शांत रहे, तो इसे बंद करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется к карточке «Эквивалент» на странице тренировки: мягкий отклик при каждом столкновении двух продуктов. Выключите, если хотите, чтобы карточка работала без вибрации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman ayrıntı sayfasındaki Kalori Karşılığı kartı için geçerlidir: iki yiyecek her çarpıştığında hafif bir titreşim. Kartın sessiz kalmasını tercih ederseniz bunu kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于体能训练详情页的热量等价卡片：每当两种食物碰撞时轻轻震动一下。如果希望卡片保持安静，可将其关闭。"
          }
        }
      }
    },
    "Applies when a refresh you pulled finishes or fails, when a workout share card is saved to Photos or cannot be saved, when a Body Pro purchase or restore succeeds or fails, when the Readiness score lands on Summary or drops sharply, and the first time a High or Low warning card appears." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn eine von dir ausgelöste Aktualisierung abgeschlossen ist oder fehlschlägt, wenn eine Teilen-Karte eines Trainings in Fotos gesichert wird oder nicht gesichert werden kann, wenn ein Kauf oder eine Wiederherstellung von Body Pro gelingt oder fehlschlägt, wenn der Tagesformwert in der Übersicht erscheint oder stark sinkt, und wenn zum ersten Mal eine Warnkarte für hohe oder niedrige Werte erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when a refresh you pulled finishes or fails, when a workout share card is saved to Photos or cannot be saved, when a Body Pro purchase or restore succeeds or fails, when the Readiness score lands on Summary or drops sharply, and the first time a High or Low warning card appears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica cuando termina o falla una actualización que iniciaste deslizando hacia abajo, cuando una tarjeta para compartir un entrenamiento se guarda en Fotos o no se puede guardar, cuando una compra o restauración de Body Pro se completa o falla, cuando la puntuación de preparación aparece en Resumen o cae bruscamente, y la primera vez que aparece una tarjeta de aviso de valor alto o bajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique lorsqu’une actualisation lancée en tirant vers le bas se termine ou échoue, lorsqu’une carte de partage d’exercice est enregistrée dans Photos ou ne peut pas l’être, lorsqu’un achat ou un rétablissement de Body Pro aboutit ou échoue, lorsque le score de préparation s’affiche dans Résumé ou chute brusquement, et la première fois qu’une carte d’avertissement « Élevé » ou « Faible » apparaît."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तब लागू होता है जब नीचे खींचकर किया गया रीफ़्रेश पूरा या विफल होता है, जब वर्कआउट शेयर कार्ड “तस्वीर” में सहेजा जाता है या सहेजा नहीं जा पाता, जब Body Pro की ख़रीदारी या रीस्टोर सफल या विफल होता है, जब रेडिनेस स्कोर सारांश पर दिखता है या तेज़ी से गिरता है, और जब पहली बार कोई उच्च या निम्न चेतावनी कार्ड दिखता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется, когда обновление жестом вниз завершается или не удается, когда карточка тренировки для публикации сохраняется в «Фото» или не сохраняется, когда покупка или восстановление Body Pro проходит успешно или не удается, когда оценка готовности появляется в «Сводке» или резко падает, а также при первом появлении карточки предупреждения «Высоко» или «Низко»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağı çekerek başlattığınız bir yenileme bittiğinde veya başarısız olduğunda, bir antrenman paylaşım kartı Fotoğraflar'a kaydedildiğinde veya kaydedilemediğinde, bir Body Pro satın alımı ya da geri yüklemesi başarılı olduğunda veya başarısız olduğunda, Hazırlık puanı Özet'te göründüğünde ya da sert biçimde düştüğünde ve bir Yüksek veya Düşük uyarı kartı ilk kez göründüğünde geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于：下拉刷新完成或失败时，体能训练分享卡片存入照片或无法保存时，Body Pro 购买或恢复成功或失败时，准备度分数在概览页落定或大幅下降时，以及过高或过低提醒卡片首次出现时。"
          }
        }
      }
    },
    "Applies when you press and drag across a chart. Metric detail pages: the trend chart at the top, Day View, Sleep stages, Vitals, Body Radar, the trend comparison cards, and the High or Low warning cards. Workout detail pages: the Heart Rate, Elevation, Pace, Speed, Cadence, Power, Stride Length, Ground Contact Time, and Vertical Oscillation charts. The highest and lowest points of a trend chart or a workout's Heart Rate chart, and each Sleep stage change, play a firmer tick." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn du ein Diagramm gedrückt hältst und darüber ziehst. Detailseiten von Messwerten: das Trenddiagramm oben, Tagesansicht, Schlafphasen, Vitalzeichen, Körperradar, die Trendvergleichskarten und die Warnkarten für hohe oder niedrige Werte. Detailseiten von Trainings: die Diagramme für Herzfrequenz, Höhe, Pace, Geschwindigkeit, Schritt- oder Trittfrequenz, Leistung, Schrittlänge, Bodenkontaktzeit und vertikale Oszillation. Die höchsten und tiefsten Punkte eines Trenddiagramms oder des Herzfrequenzdiagramms eines Trainings sowie jeder Wechsel der Schlafphase lösen ein kräftigeres Ticken aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when you press and drag across a chart. Metric detail pages: the trend chart at the top, Day View, Sleep stages, Vitals, Body Radar, the trend comparison cards, and the High or Low warning cards. Workout detail pages: the Heart Rate, Elevation, Pace, Speed, Cadence, Power, Stride Length, Ground Contact Time, and Vertical Oscillation charts. The highest and lowest points of a trend chart or a workout's Heart Rate chart, and each Sleep stage change, play a firmer tick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica al mantener el dedo sobre una gráfica y arrastrarlo. Páginas de detalles de métricas: la gráfica de tendencia de la parte superior, Vista del día, Fases del sueño, Signos vitales, Radar corporal, las tarjetas de comparación de tendencias y las tarjetas de aviso de valor alto o bajo. Páginas de detalles de entrenamientos: las gráficas de frecuencia cardiaca, altitud, ritmo, velocidad, cadencia, potencia, longitud de zancada, tiempo de contacto con el suelo y oscilación vertical. Los puntos más alto y más bajo de una gráfica de tendencia o de la gráfica de frecuencia cardiaca de un entrenamiento, y cada cambio de fase del sueño, producen un toque más firme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique lorsque vous maintenez le doigt sur un graphique et le faites glisser. Pages de détail des mesures : le graphique de tendance en haut, la vue du jour, les phases du sommeil, les signes vitaux, le radar corporel, les cartes de comparaison de tendance et les cartes d’avertissement « Élevé » ou « Faible ». Pages de détail des exercices : les graphiques de fréquence cardiaque, d’altitude, de rythme, de vitesse, de cadence, de puissance, de longueur de foulée, de temps de contact au sol et d’oscillation verticale. Les points les plus hauts et les plus bas d’un graphique de tendance ou du graphique de fréquence cardiaque d’un exercice, ainsi que chaque changement de phase du sommeil, produisent une vibration plus marquée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप किसी चार्ट पर दबाकर ड्रैग करते हैं, तब लागू होता है। मेट्रिक विवरण पेज: सबसे ऊपर का ट्रेंड चार्ट, दिन दृश्य, नींद के चरण, वाइटल, Body रडार, ट्रेंड तुलना कार्ड, और उच्च या निम्न चेतावनी कार्ड। वर्कआउट विवरण पेज: हृदय गति, ऊँचाई, पेस, गति, केडेंस, पावर, स्ट्राइड लेंथ, ग्राउंड कॉन्टैक्ट टाइम और वर्टिकल ऑसिलेशन चार्ट। ट्रेंड चार्ट या वर्कआउट के हृदय गति चार्ट के सबसे ऊँचे और सबसे निचले बिंदु पर, और नींद के हर चरण बदलाव पर, ज़्यादा मज़बूत टिक महसूस होती है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется, когда Вы нажимаете на график и ведете по нему пальцем. Страницы показателей: график тренда вверху, «Просмотр дня», стадии сна, основные показатели, радар тела, карточки сравнения трендов и карточки предупреждений «Высоко» и «Низко». Страницы тренировок: графики пульса, высоты, темпа, скорости, каденса, мощности, длины шага, времени контакта с землей и вертикальных колебаний. Самая высокая и самая низкая точки графика тренда или графика пульса тренировки, а также каждая смена стадии сна отмечаются более четким щелчком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir grafiğe basılı tutup sürüklediğinizde geçerlidir. Ölçüm ayrıntı sayfaları: üstteki eğilim grafiği, Gün Görünümü, Uyku evreleri, Yaşam Bulguları, Vücut Radarı, eğilim karşılaştırma kartları ve Yüksek veya Düşük uyarı kartları. Antrenman ayrıntı sayfaları: Kalp Atış Hızı, Yükseklik, Tempo, Hız, Kadans, Güç, Adım Uzunluğu, Yerle Temas Süresi ve Dikey Salınım grafikleri. Bir eğilim grafiğinin veya antrenmanın Kalp Atış Hızı grafiğinin en yüksek ve en düşük noktaları ile her uyku evresi değişikliği daha belirgin bir tık verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图表上按住并拖动时生效。指标详情页：顶部趋势图、日视图、睡眠阶段、体征、身体雷达、趋势对比卡片，以及过高或过低提醒卡片。体能训练详情页：心率、海拔、配速、速度、步频、功率、步幅、触地时间和垂直振幅图表。趋势图或体能训练心率图的最高点和最低点，以及每次睡眠阶段变化，会有更明显的震动。"
          }
        }
      }
    },
    "Applies when you tap a card to open its page. Summary: the readiness hero, the metric cards, the Activity Rings card, and the trend cards. Workouts: each workout in the list, a calendar day with workouts, a workout type row, the chart switch, and each workout in the sheet a day or a type opens. Metric detail pages: the Basics trend cards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn du auf eine Karte tippst, um ihre Seite zu öffnen. Übersicht: die Tagesform-Hauptkarte, die Messwertkarten, die Karte mit den Aktivitätsringen und die Trendkarten. Trainings: jedes Training in der Liste, ein Kalendertag mit Trainings, eine Zeile mit einer Trainingsart, der Diagrammumschalter und jedes Training in dem Fenster, das ein Tag oder eine Trainingsart öffnet. Detailseiten von Messwerten: die Trendkarten für Körpermesswerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when you tap a card to open its page. Summary: the readiness hero, the metric cards, the Activity Rings card, and the trend cards. Workouts: each workout in the list, a calendar day with workouts, a workout type row, the chart switch, and each workout in the sheet a day or a type opens. Metric detail pages: the Basics trend cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica al tocar una tarjeta para abrir su página. Resumen: la portada de preparación, las tarjetas de métricas, la tarjeta de Anillos de actividad y las tarjetas de tendencia. Entrenamientos: cada entrenamiento de la lista, un día del calendario con entrenamientos, una fila de tipo de entrenamiento, el selector de gráfica y cada entrenamiento de la hoja que abre un día o un tipo. Páginas de detalles de métricas: las tarjetas de tendencia de Datos básicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique lorsque vous touchez une carte pour ouvrir sa page. Résumé : la carte principale de préparation, les cartes de mesures, la carte Anneaux Activité et les cartes de tendance. Exercices : chaque exercice de la liste, un jour du calendrier comportant des exercices, une ligne de type d’exercice, le sélecteur de graphique et chaque exercice de la feuille qu’ouvre un jour ou un type. Pages de détail des mesures : les cartes de tendance des mensurations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप किसी कार्ड पर टैप करके उसका पेज खोलते हैं, तब लागू होता है। सारांश: रेडिनेस हीरो, मेट्रिक कार्ड, ऐक्टिविटी रिंग कार्ड और ट्रेंड कार्ड। वर्कआउट: सूची का हर वर्कआउट, वर्कआउट वाला कैलेंडर दिन, वर्कआउट के प्रकार की पंक्ति, चार्ट स्विच, और किसी दिन या प्रकार से खुलने वाली शीट का हर वर्कआउट। मेट्रिक विवरण पेज: बुनियादी माप के ट्रेंड कार्ड।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется, когда Вы касаетесь карточки, чтобы открыть ее страницу. «Сводка»: главная карточка готовности, карточки показателей, карточка «Кольца Активности» и карточки трендов. «Тренировки»: каждая тренировка в списке, день календаря с тренировками, строка типа тренировки, переключатель графика и каждая тренировка в панели, которую открывает день или тип. Страницы показателей: карточки трендов измерений тела."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kartın sayfasını açmak için ona dokunduğunuzda geçerlidir. Özet: Hazırlık göstergesi, ölçüm kartları, Aktivite Halkaları kartı ve eğilim kartları. Antrenmanlar: listedeki her antrenman, antrenman içeren bir takvim günü, bir antrenman türü satırı, grafik geçişi ve bir günün veya türün açtığı sayfadaki her antrenman. Ölçüm ayrıntı sayfaları: Temel Veriler eğilim kartları."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点卡片打开其页面时生效。概览：准备度主区、指标卡片、活动圆环卡片和趋势卡片。体能训练：列表中的每条训练、有训练的日历日期、训练类型行、图表切换，以及日期或类型所打开面板中的每条训练。指标详情页：身体基础趋势卡片。"
          }
        }
      }
    },
    "Applies when you tap Week, Month, 6 Months, or Year at the top of a metric detail page, including a locked range that opens Body Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn du oben auf der Detailseite eines Messwerts auf „Woche“, „Monat“, „6 Monate“ oder „Jahr“ tippst, auch bei einem gesperrten Zeitraum, der Body Pro öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when you tap Week, Month, 6 Months, or Year at the top of a metric detail page, including a locked range that opens Body Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica al tocar Semana, Mes, 6 meses o Año en la parte superior de la página de detalles de una métrica, incluido un periodo bloqueado que abre Body Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique lorsque vous touchez Semaine, Mois, 6 mois ou Année en haut de la page de détail d’une mesure, y compris une période verrouillée qui ouvre Body Pro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप मेट्रिक विवरण पेज के सबसे ऊपर सप्ताह, माह, 6 माह या वर्ष पर टैप करते हैं, तब लागू होता है, इसमें वह लॉक रेंज भी शामिल है जो Body Pro खोलती है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется при касании «Неделя», «Месяц», «6 месяцев» или «Год» вверху страницы показателя, в том числе заблокированного периода, который открывает Body Pro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ölçüm ayrıntı sayfasının üstündeki Hafta, Ay, 6 Ay veya Yıl seçeneğine dokunduğunuzda geçerlidir. Body Pro'yu açan kilitli bir aralık da buna dahildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在指标详情页顶部轻点周、月、6个月或年时生效，包括会打开 Body Pro 的锁定范围。"
          }
        }
      }
    },
