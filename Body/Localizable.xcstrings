    "onboarding.readiness.live" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verändert sich im Laufe des Tages"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It moves through the day"
          }
        },
        "es" : {
