          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议开启全部类别，以获得最完整的身体状况分析。"
          }
        }
      }
    },
    "onboarding.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weiter“ öffnet das Berechtigungsfenster von Health. Was Body lesen darf, kannst du jederzeit unter Einstellungen › Daten › Berechtigungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
