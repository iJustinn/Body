      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Trainings. Trainingsarten erscheinen hier, sobald du sie erfasst hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No workouts yet. Workout types appear here once you've logged them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay entrenamientos. Los tipos de entrenamiento aparecen aquí cuando los registras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun exercice pour le moment. Les types d’exercice apparaissent ici une fois enregistrés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई वर्कआउट नहीं। वर्कआउट दर्ज करने के बाद उनके प्रकार यहाँ दिखते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировок пока нет. Типы тренировок появятся здесь после их записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz antrenman yok. Antrenman türleri, kaydettiğinizde burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有运动记录。记录运动后，类型会显示在这里。"
          }
        }
      }
    },
    "workoutColors.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Training, um ihm deine eigene Farbe zu geben. Alles, was dieses Training zeigt, verwendet sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a workout to give it your own color. Everything that shows that workout uses it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un entrenamiento para darle tu propio color. Todo lo que muestre ese entrenamiento lo usará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un exercice pour lui attribuer votre propre couleur. Tout ce qui affiche cet exercice l’utilise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी वर्कआउट को अपना रंग देने के लिए उस पर टैप करें। वह वर्कआउट जहाँ भी दिखता है, वहाँ यही रंग इस्तेमाल होता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь тренировки, чтобы задать ей свой цвет. Он используется везде, где показывается эта тренировка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi renginizi vermek için bir antrenmana dokunun. O antrenmanı gösteren her yer bu rengi kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按某项运动即可为其设置专属颜色。凡是显示该运动的地方都会使用这个颜色。"
          }
        }
      }
    },
