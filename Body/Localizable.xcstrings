            "value" : "Régularité du sommeil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद की संगतता"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярность сна"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku düzenliliği"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠规律性"
          }
        }
      }
    },
    "onboarding.sleep.consistency.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie gleichmäßig deine Schlafens- und Aufwachzeiten in den letzten Nächten waren, als Prozentwert. Regelmäßige Zeiten fließen in deinen Schlafindex ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How steady your bedtimes and wake times are across recent nights, shown as a percentage. Regular timing is one of the inputs to your sleep score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo estables que son tus horas de acostarte y de despertarte en las últimas noches, en porcentaje. Un horario regular es uno de los factores de tu puntuación del sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stabilité de vos heures de coucher et de réveil sur les dernières nuits, exprimée en pourcentage. Des horaires réguliers font partie des éléments de votre score de sommeil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की रातों में आपके सोने और जागने का समय कितना स्थिर रहा, यह प्रतिशत में दिखाया जाता है। नियमित समय आपके नींद के स्कोर का एक हिस्सा है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько стабильно время отхода ко сну и пробуждения в последние ночи, в процентах. Регулярный режим входит в оценку сна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son gecelerde yatma ve uyanma saatlerinizin ne kadar düzenli olduğu, yüzde olarak gösterilir. Düzenli zamanlama, uyku puanınızın girdilerinden biridir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期各晚的入睡和起床时间有多稳定，以百分比显示。作息规律是睡眠评分的组成部分之一。"
          }
        }
      }
    },
    "onboarding.sleep.goal" : {
