            "value" : "आपके शरीर की सबसे पूरी तस्वीर के लिए हम हर श्रेणी चालू करने की सलाह देते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендуем включить все категории, чтобы получить наиболее полную картину состояния тела."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
