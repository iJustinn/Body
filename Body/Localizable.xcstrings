        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте медиафайл, затем выберите «Макет», чтобы переместить данные тренировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medyayı ayarlayın, ardından antrenman bilgilerini taşımak için Yerleşim'i seçin."
          }
        },
