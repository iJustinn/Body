        }
      }
    },
    "onboarding.calendar.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tab „Trainings“ fasst jeden Monat auf zwei Arten zusammen. Der Kalender markiert jeden Tag danach, wie viele Trainings du gemacht hast. Die Markierungen addieren sich, ein Mond und ein Stern bedeuten also vier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Workouts tab sums up each month two ways. The calendar marks every day by how many workouts you did, and markers stack, so a moon and a star mean four."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Entrenamientos resume cada mes de dos formas. El calendario marca cada día según cuántos entrenamientos hiciste, y las marcas se suman, así que una luna y una estrella son cuatro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Exercices résume chaque mois de deux façons. Le calendrier marque chaque jour selon le nombre d’exercices effectués, et les symboles se cumulent : une lune et une étoile valent quatre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कआउट टैब हर महीने का सारांश दो तरह से देता है। कैलेंडर हर दिन पर इस हिसाब से निशान लगाता है कि आपने कितने वर्कआउट किए, और निशान जुड़ते जाते हैं, यानी एक चाँद और एक तारा मतलब चार।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладка «Тренировки» подводит итоги каждого месяца двумя способами. Календарь отмечает каждый день по числу тренировок, а значки складываются, поэтому луна и звезда означают четыре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanlar sekmesi her ayı iki şekilde özetler. Takvim her günü yaptığınız antrenman sayısına göre işaretler ve işaretler toplanır, yani bir ay ve bir yıldız dört demektir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“运动”标签页用两种方式汇总每个月。日历用标记显示每天的运动次数，标记可叠加，例如月亮加星星表示四次。"
          }
        }
      }
    },
