    "updateOnboarding.feature.refresh.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die neue Struktur muss Body bei jeder Aktualisierung weniger aus Health lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new structure lets Body read less from Apple Health each time it updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva estructura permite que Body lea menos datos de la app Salud en cada actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle structure permet à Body de lire moins de données dans l’app Santé à chaque mise à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई संरचना की वजह से Body हर अपडेट पर सेहत से कम डेटा पढ़ता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая структура позволяет Body читать меньше данных из приложения «Здоровье» при каждом обновлении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni yapı sayesinde Body her güncellemede Sağlık uygulamasından daha az veri okur."
          }
        },
        "zh-Hans" : {
