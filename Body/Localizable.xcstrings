    "onboarding.done.sources.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Einstellungen › Daten › Quelle wählst du, welche Quelle aus Health jeder Messwert nutzt, und legst eine zweite zum Vergleich darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings › Data › Source lets you pick which Apple Health source each metric uses and overlay a second one for comparison."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes › Datos › Fuente puedes elegir qué fuente de la app Salud usa cada métrica y superponer una segunda para compararlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages › Données › Source vous permet de choisir la source de l’app Santé utilisée par chaque mesure et d’en superposer une deuxième pour comparer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग › डेटा › सोर्स में आप चुन सकते हैं कि हर मेट्रिक सेहत के किस सोर्स का इस्तेमाल करे, और तुलना के लिए उस पर दूसरा सोर्स भी दिखा सकते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Настройки» › «Данные» › «Источник» можно выбрать источник из приложения «Здоровье» для каждого показателя и наложить второй для сравнения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar › Veriler › Kaynak bölümünde her ölçümün hangi Sağlık kaynağını kullanacağını seçebilir ve karşılaştırma için ikinci bir kaynağı üst üste gösterebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置›数据›来源中，为每项指标选择所用的 Apple 健康来源，并叠加第二个来源进行对比。"
          }
        }
      }
    },
