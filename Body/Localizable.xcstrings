      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each night is split into Core, Deep, REM, and Awake. Deep and REM together are your restorative sleep, the part that repairs the body and consolidates memory."
          }
