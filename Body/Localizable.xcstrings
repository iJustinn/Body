    "notifications.stress.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Mitteilung, wenn Body bei der Prüfung im Hintergrund anhand deiner Herzdaten eine neue Phase mit hohem Stress erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified when a new period of high stress is detected from your heart data while Body checks in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso cuando se detecte un nuevo periodo de estrés alto en tus datos cardiacos mientras Body hace comprobaciones en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification lorsqu’un nouvel épisode de stress élevé est détecté dans vos données cardiaques pendant les vérifications en arrière-plan de Body."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Body बैकग्राउंड में जाँच करते समय आपके हृदय डेटा से ज़्यादा तनाव का कोई नया दौर पहचाने, तब सूचना पाएँ।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомление, когда во время фоновой проверки Body обнаруживает по данным сердца новый период высокого стресса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body arka planda denetim yaparken kalp verilerinizden yeni bir yüksek stres dönemi algılandığında bildirim alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Body 在后台检查时，根据心脏数据检测到新的高压力时段时通知您。"
          }
        }
      }
    },
    "notifications.stress.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhin hoher Stress erkannt"
          }
        },
        "en" : {
