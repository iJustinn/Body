    "updateOnboarding.keepOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Body geöffnet und im Vordergrund, bis das Laden abgeschlossen ist. Wenn du die App verlässt, kann es unterbrochen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please keep Body open and in the foreground until the load finishes. Leaving the app can interrupt it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Body en primer plano hasta que termine la carga. Si sales de la app, la carga se puede interrumpir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Body ouvert et au premier plan jusqu’à la fin du chargement. Quitter l’app peut l’interrompre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोडिंग पूरी होने तक कृपया Body को खुला और स्क्रीन पर रखें। ऐप से बाहर जाने पर यह रुक सकती है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывайте Body и не сворачивайте его до завершения загрузки. Если выйти из приложения, загрузка может прерваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme bitene kadar lütfen Body'yi açık ve ön planda tutun. Uygulamadan çıkmak yüklemeyi kesintiye uğratabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "载入完成前请保持 Body 打开并停留在前台。离开 App 可能会中断载入。"
          }
        }
      }
    },
