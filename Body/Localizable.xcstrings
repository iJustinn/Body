        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet alle Mitteilungen von Body ein oder aus. Deine Auswahl unten bleibt erhalten, solange diese Option deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
