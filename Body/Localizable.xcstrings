    "onboarding.welcome.load" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body richtet deine Übersicht mit deinen Daten aus Health ein. Das erste Laden kann einen Moment dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body sets up your dashboard with your Apple Health data. This first load can take a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body prepara tu panel con tus datos de la app Salud. Esta primera carga puede tardar un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body prépare votre tableau de bord avec vos données Santé. Ce premier chargement peut prendre un moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body आपके सेहत डेटा से आपका डैशबोर्ड तैयार करता है। पहली बार लोड होने में थोड़ा समय लग सकता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body настраивает панель по данным из приложения «Здоровье». Первая загрузка может занять немного времени."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body, Sağlık verilerinizle panonuzu hazırlar. Bu ilk yükleme biraz zaman alabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会用您的 Apple 健康数据搭建仪表盘。首次载入可能需要一点时间。"
          }
        }
      }
    },
    "onboarding.welcome.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf deinem Gerät"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays on your device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en tu dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur votre appareil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका डेटा आपके डिवाइस पर ही रहता है"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные остаются на устройстве"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verileriniz aygıtınızda kalır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的数据只留在设备上"
          }
        }
      }
    },
    "onboarding.welcome.privacy.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body liest Health direkt auf dem Gerät und behält alles dort. Es gibt kein Konto, keinen eigenen Server und kein Tracking, deine Gesundheitsdaten werden also nirgendwohin hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads Apple Health on device and keeps everything there. There is no account, no server of ours, and no tracking, so your health data is never uploaded anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body lee la app Salud en tu dispositivo y lo guarda todo ahí. No hay cuenta, ni servidores nuestros, ni rastreo, así que tus datos de salud nunca se suben a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body lit les données de l’app Santé sur l’appareil et les y conserve. Pas de compte, pas de serveur de notre part, pas de suivi : vos données de santé ne sont jamais envoyées nulle part."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body सेहत डेटा डिवाइस पर ही पढ़ता है और सब कुछ वहीं रखता है। न कोई खाता, न हमारा कोई सर्वर, न कोई ट्रैकिंग, इसलिए आपका सेहत डेटा कभी कहीं अपलोड नहीं होता।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body читает данные приложения «Здоровье» на устройстве и хранит все там же. Нет ни учетной записи, ни наших серверов, ни отслеживания, поэтому Ваши медданные никуда не загружаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body, Sağlık verilerini aygıtta okur ve her şeyi orada tutar. Hesap yok, bize ait bir sunucu yok, izleme yok. Bu yüzden sağlık verileriniz hiçbir yere yüklenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 在设备本地读取 Apple 健康数据，并将全部内容保留在本地。没有账户，没有我们的服务器，也没有任何追踪，您的健康数据不会被上传到任何地方。"
          }
        }
      }
    },
    "onboarding.welcome.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei ohmybody (Body)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to ohmybody (Body)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos la bienvenida a ohmybody (Body)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans ohmybody (Body)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ohmybody (Body) में आपका स्वागत है"
          }
        },
        "ru" : {
          "stringUnit" : {
