    "onboarding.sleep.goalHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body bewertet deinen Schlaf anhand dieses Ziels. Du kannst es jederzeit unter Einstellungen › Messwerte › Schlaf ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body scores your sleep against this target. Change it anytime in Settings › Metrics › Sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body puntúa tu sueño según este objetivo. Cámbialo cuando quieras en Ajustes › Métricas › Sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body note votre sommeil par rapport à cet objectif. Modifiez-le à tout moment dans Réglages › Mesures › Sommeil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body आपकी नींद का स्कोर इसी लक्ष्य के हिसाब से तय करता है। इसे कभी भी सेटिंग › मेट्रिक्स › नींद में बदलें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body оценивает Ваш сон относительно этой цели. Изменить ее можно в любой момент в разделе «Настройки» › «Показатели» › «Сон»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body uykunuzu bu hedefe göre puanlar. İstediğiniz zaman Ayarlar › Ölçümler › Uyku bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会根据这个目标为您的睡眠打分。您可以随时在设置›指标›睡眠中更改。"
          }
        }
      }
    },
    "onboarding.sleep.stages" : {
      "extractionState" : "manual",
      "localizations" : {
