      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir empfehlen, alle Kategorien zu aktivieren, damit du das vollständigste Bild deines Körpers erhältst."
          }
        },
        "en" : {
          "stringUnit" : {
