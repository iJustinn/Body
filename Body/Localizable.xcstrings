    "onboarding.readiness.live.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle Wert von heute wird laufend aktualisiert und sinkt nach einem Training, während das Trenddiagramm den Wert von kurz nach dem Aufwachen behält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's live score updates as you go and drops after a workout, while the trend chart keeps the value from shortly after you wake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuación de hoy se actualiza en tiempo real y baja después de un entrenamiento, mientras que la gráfica de tendencia conserva el valor de poco después de despertarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le score en direct du jour se met à jour au fil de la journée et baisse après un exercice, tandis que le graphique de tendance conserve la valeur mesurée peu après votre réveil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का लाइव स्कोर दिन के साथ अपडेट होता है और वर्कआउट के बाद गिरता है, जबकि ट्रेंड चार्ट आपके जागने के कुछ देर बाद का मान रखता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая оценка обновляется в течение дня и снижается после тренировки, а график тренда сохраняет значение, полученное вскоре после пробуждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünün anlık puanı gün içinde güncellenir ve bir antrenmandan sonra düşer. Eğilim grafiği ise uyandıktan kısa süre sonraki değeri korur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日的实时评分会随时间更新，并在运动后下降；趋势图则保留您醒来不久后的数值。"
          }
        }
      }
    },
    "onboarding.readiness.patterns" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhaltende Muster zählen am meisten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustained patterns matter most"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que más importa son los patrones sostenidos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances durables comptent le plus"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार बने पैटर्न सबसे ज़्यादा मायने रखते हैं"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важнее всего устойчивые закономерности"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalıcı örüntüler en önemlisidir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持续的趋势最重要"
          }
        }
      }
    },
    "onboarding.readiness.patterns.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das stärkste Signal kommt von wiederkehrenden Mustern bei HRV, Ruheherzfrequenz, Schlafqualität und jüngster Belastung, nicht von einem einzelnen Messwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The strongest signal comes from repeated patterns across HRV, resting heart rate, sleep quality, and recent load rather than one isolated reading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La señal más fiable viene de patrones repetidos en la VFC, la frecuencia cardiaca en reposo, la calidad del sueño y la carga reciente, no de una lectura aislada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signal le plus fiable vient de tendances répétées de la VFC, de la fréquence cardiaque au repos, de la qualité du sommeil et de la charge récente, plutôt que d’un relevé isolé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे मज़बूत संकेत किसी एक अलग रीडिंग से नहीं, बल्कि HRV, विश्राम हृदय गति, नींद की गुणवत्ता और हाल के लोड में बार बार दिखने वाले पैटर्न से मिलता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самый надежный сигнал дают повторяющиеся закономерности в ВСР, пульсе в покое, качестве сна и недавней нагрузке, а не одно отдельное значение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En güçlü sinyal tek bir ölçümden değil, HRV, dinlenirken kalp atış hızı, uyku kalitesi ve son dönemdeki yükte tekrarlanan örüntülerden gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最可靠的信号来自 HRV、静息心率、睡眠质量和近期负荷的持续变化，而不是单次读数。"
          }
        }
      }
    },
    "onboarding.readiness.signals" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen an deinem eigenen Basiswert"
          }
        },
        "en" : {
