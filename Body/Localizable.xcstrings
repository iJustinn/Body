    "onboarding.calendar.star.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Sterne bedeuten zwei Trainings."
          }
        },
        "en" : {
          "stringUnit" : {
