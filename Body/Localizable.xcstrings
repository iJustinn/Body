    "At least one metric stays on the long image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Messwert bleibt auf dem langen Bild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one metric stays on the long image."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen larga conserva al menos una métrica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image longue doit conserver au moins une mesure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबी इमेज पर कम से कम एक मेट्रिक बना रहता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
