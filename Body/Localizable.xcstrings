    "Include leading and trailing Awake in sleep stages" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachphasen am Anfang und Ende in die Schlafphasen einbeziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
