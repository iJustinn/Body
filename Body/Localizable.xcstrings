    "Every metric's individual source choice will be replaced by the Primary and Secondary Data Source selected here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die individuelle Quellenwahl jedes Messwerts wird durch die hier gewählte Haupt- und Vergleichsquelle ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every metric's individual source choice will be replaced by the Primary and Secondary Data Source selected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente elegida para cada métrica se sustituirá por la fuente de datos principal y la secundaria seleccionadas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le choix de source propre à chaque mesure sera remplacé par la source de données principale et la source secondaire sélectionnées ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर मेट्रिक के लिए अलग से चुना गया सोर्स, यहाँ चुने गए प्राथमिक और द्वितीयक डेटा सोर्स से बदल दिया जाएगा।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники, выбранные отдельно для каждого показателя, будут заменены основным и дополнительным источниками данных, выбранными здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ölçümün kendi kaynak seçimi, burada seçilen Birincil ve Karşılaştırma Veri Kaynağı ile değiştirilecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每项指标的单独数据源设置都将替换为此处选择的主要和次要数据源。"
          }
        }
      }
    },
