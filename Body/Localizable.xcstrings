        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body सेहत में प्रयास रेटिंग सहेज नहीं सका। पक्का करें कि सेटिंग › सेहत › डेटा ऐक्सेस और डिवाइस में Body को वर्कआउट अपडेट करने की अनुमति है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить оценку усилия в приложении «Здоровье». Убедитесь, что Body разрешено обновлять тренировки в разделе «Настройки» › «Здоровье» › «Доступ к данным и устройства»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body, efor puanını Sağlık uygulamasına kaydedemedi. Ayarlar › Sağlık › Veri Erişimi ve Aygıtlar bölümünde Body'nin Antrenmanlar verisini güncellemesine izin verildiğinden emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
