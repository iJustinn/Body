    "notifications.readiness.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Tagesform startet heute bei %lld%% (%@). Tippe, um zu sehen, was sie beeinflusst hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're starting today at %lld%% (%@). Tap to see what shaped it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empiezas el día con un %lld%% (%@). Toca para ver qué influyó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre niveau de préparation démarre la journée à %lld %% (%@). Touchez pour voir ce qui l’a influencé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज आपकी रेडिनेस %lld%% (%@) से शुरू हो रही है। टैप करके देखें कि इस पर किन बातों का असर रहा।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовность на начало дня: %lld%% (%@). Коснитесь, чтобы узнать, что на нее повлияло."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugüne %%%lld (%@) hazırlıkla başlıyorsunuz. Neyin etkilediğini görmek için dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您今天的起始就绪状态为 %lld%%（%@）。轻点查看影响因素。"
          }
        }
      }
    },
    "notifications.readiness.footer" : {
