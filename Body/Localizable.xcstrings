    "Reads today's readiness score from Body's cached health data, and the start of day score when workouts lowered it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest den heutigen Tagesformwert aus den zwischengespeicherten Gesundheitsdaten von Body und, falls Trainings ihn gesenkt haben, den Wert zu Tagesbeginn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads today's readiness score from Body's cached health data, and the start of day score when workouts lowered it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee la puntuación de preparación de hoy de los datos de salud en caché de Body, y la puntuación del inicio del día si los entrenamientos la bajaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
