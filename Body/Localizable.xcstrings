        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखें पर टैप करने से सेहत की अनुमति शीट खुलती है। Body क्या पढ़ सकता है, यह आप कभी भी सेटिंग › डेटा › अनुमतियाँ में बदल सकते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Продолжить» открывает окно доступа приложения «Здоровье». Изменить, что может читать Body, можно в любой момент в разделе «Настройки» › «Данные» › «Права доступа»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam, Sağlık izin sayfasını açar. Body'nin neleri okuyabileceğini istediğiniz zaman Ayarlar › Veriler › İzinler bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
