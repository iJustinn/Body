    "onboarding.sleep.baseline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Basiswert zählt mehr als eine Nacht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your baseline beats one night"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu referencia pesa más que una noche"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre référence compte plus qu’une nuit"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक रात से ज़्यादा अहम है आपकी बेसलाइन"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Базовый уровень важнее одной ночи"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referansınız tek bir geceden daha önemlidir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基准比单晚更重要"
          }
        }
      }
    },
    "onboarding.sleep.baseline.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze oder unruhige Nacht ist weniger wichtig als der Vergleich mit dem, was für dich normal ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One short or restless night matters less than how it compares with what is normal for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una noche corta o inquieta importa menos que cómo se compara con lo que es normal para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nuit courte ou agitée compte moins que sa comparaison avec ce qui est normal pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक छोटी या बेचैन रात उतनी अहम नहीं, जितना यह कि वह आपके सामान्य से कैसी रही।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна короткая или беспокойная ночь значит меньше, чем ее сравнение с тем, что нормально для Вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa ya da huzursuz tek bir gecenin kendisinden çok, sizin için normal olanla kıyaslandığında nasıl göründüğü önemlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一晚睡得短或不安稳并不重要，关键在于它与您平时的睡眠相比如何。"
          }
        }
      }
    },
    "onboarding.sleep.consistency" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafregelmäßigkeit"
          }
        },
        "en" : {
          "stringUnit" : {
