    "stressUpdate.feature.recovery.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Spaziergang oder Yoga folgt eine kurze Erholungsphase, bevor Stress wieder bewertet wird, nach härterem Training eine längere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A walk or yoga gets a short recovery before Stress scores again, harder training a longer one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una caminata o una sesión de yoga hay una recuperación corta antes de que se vuelva a puntuar el estrés, y tras un entrenamiento más duro, una más larga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une marche ou du yoga, une courte récupération précède le retour du score de stress ; après un entraînement plus intense, elle est plus longue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉक या योग के बाद तनाव को दोबारा स्कोर करने से पहले थोड़ी देर की रिकवरी मिलती है, कठिन ट्रेनिंग के बाद ज़्यादा देर की।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После прогулки или йоги стресс снова оценивается после короткого восстановления, а после более тяжелой тренировки восстановление длится дольше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürüyüş veya yogadan sonra Stres yeniden puanlanmadan önce kısa bir toparlanma süresi tanınır, daha zorlu antrenmanlardan sonra bu süre daha uzundur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行或瑜伽之后只需短暂恢复，压力就会重新评分；强度更高的训练之后，恢复期会更长。"
          }
        }
      }
    },
    "stressUpdate.feature.recovery.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholung nach Trainings"
          }
        },
        "en" : {
