    "accessibility.workoutColorWheelHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um Farbton und Sättigung festzulegen. Mit dem Helligkeitsregler und den Feldern für Hex und RGB legst du genaue Werte fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to set hue and saturation. Use the Brightness slider and the Hex and RGB fields to set exact values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para ajustar el tono y la saturación. Usa el regulador de brillo y los campos Hex y RGB para fijar valores exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour régler la teinte et la saturation. Utilisez le curseur « Luminosité », le champ « Hex » et les champs RVB pour définir des valeurs exactes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ह्यू और सैचुरेशन सेट करने के लिए ड्रैग करें। सटीक मान सेट करने के लिए ब्राइटनेस स्लाइडर और Hex व RGB फ़ील्ड का उपयोग करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните, чтобы выбрать оттенок и насыщенность. Точные значения можно задать ползунком «Яркость» и полями Hex и RGB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton ve doygunluğu ayarlamak için sürükleyin. Tam değerler için Parlaklık sürgüsünü ve Hex ile RGB alanlarını kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以设置色相和饱和度。可使用“亮度”滑块以及“十六进制”和 RGB 输入框来设置精确数值。"
          }
        }
