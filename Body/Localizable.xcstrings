    "bodyRadar.warning.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruh dich aus und achte darauf, wie du dich fühlst. Körperradar ist kein Medizinprodukt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest and notice how you feel. Body Radar is not a medical device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa y presta atención a cómo te sientes. Radar corporal no es un dispositivo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposez-vous et écoutez votre corps. Le radar corporel n’est pas un dispositif médical."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आराम करें और ध्यान दें कि आप कैसा महसूस कर रहे हैं। Body रडार कोई चिकित्सा उपकरण नहीं है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдохните и прислушайтесь к своему самочувствию. Радар тела не является медицинским устройством."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlenin ve kendinizi nasıl hissettiğinize dikkat edin. Vücut Radarı tıbbi bir aygıt değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意休息，留意身体感受。身体雷达不是医疗设备。"
          }
        }
      }
    },
