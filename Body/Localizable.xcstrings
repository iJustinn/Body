    "onboarding.effort.rate.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ein Training, tippe auf die Karte „Anstrengung“ und wähle einen Wert von 1 bis 10. Leicht, Moderat, Schwer und Extrem richten sich nach der Zahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a workout, tap the Effort card, and set a value from 1 to 10. Easy, Moderate, Hard, and All Out follow the number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un entrenamiento, toca la tarjeta Esfuerzo y elige un valor del 1 al 10. Fácil, Moderado, Difícil y Al máximo cambian según el número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un exercice, touchez la carte Effort et choisissez une valeur de 1 à 10. Facile, Modéré, Difficile et Maximum suivent le chiffre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई वर्कआउट खोलें, प्रयास कार्ड पर टैप करें और 1 से 10 तक कोई मान सेट करें। आसान, मध्यम, कठिन और बहुत कठिन संख्या के साथ बदलते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте тренировку, коснитесь карточки «Усилие» и выберите значение от 1 до 10. «Легко», «Средне», «Тяжело» и «Экстремально» меняются вместе с числом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir antrenmanı açın, Efor kartına dokunun ve 1 ile 10 arasında bir değer belirleyin. Kolay, Orta, Zor ve Tükendim etiketleri bu sayıya göre değişir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开一次运动，点按“强度”卡片，即可设定 1 到 10 的数值。轻松、中等、艰难和全力以赴会随数值变化。"
          }
        }
      }
    },
