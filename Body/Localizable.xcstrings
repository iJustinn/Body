    "Unrated only. Body never changes an effort you or your Apple Watch already set." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur unbewertete. Body ändert nie eine Anstrengung, die du oder deine Apple Watch bereits festgelegt habt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrated only. Body never changes an effort you or your Apple Watch already set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los no valorados. Body nunca cambia un esfuerzo que tú o tu Apple Watch ya hayan definido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercices non évalués uniquement. Body ne modifie jamais un effort déjà défini par vous ou votre Apple Watch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ बिना रेटिंग वाले। Body कभी भी वह प्रयास नहीं बदलता जो आपने या आपकी Apple Watch ने पहले से सेट किया हो।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только неоцененные. Body никогда не меняет усилие, уже заданное Вами или Вашими Apple Watch."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca puanlanmamış olanlar. Body, sizin veya Apple Watch'unuzun önceden belirlediği bir eforu asla değiştirmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限未评分：Body 绝不会改动你或你的 Apple Watch 已设置的强度。"
          }
        }
      }
    },
