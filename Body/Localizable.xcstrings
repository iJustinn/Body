    "Only the past 2 days. Body fills workouts that ended within the last 48 hours and leaves older ones alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die letzten 2 Tage. Body füllt Trainings aus, die in den letzten 48 Stunden geendet haben, und lässt ältere unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the past 2 days. Body fills workouts that ended within the last 48 hours and leaves older ones alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los últimos 2 días. Body completa los entrenamientos que terminaron en las últimas 48 horas y no toca los anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les 2 derniers jours. Body remplit les exercices terminés au cours des 48 dernières heures et ne touche pas aux plus anciens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ पिछले 2 दिन। Body सिर्फ़ उन्हीं वर्कआउट को भरता है जो पिछले 48 घंटों में ख़त्म हुए, पुराने वर्कआउट को नहीं छूता।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только за последние 2 дня. Body заполняет тренировки, завершившиеся за последние 48 часов, и не трогает более ранние."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca son 2 gün. Body son 48 saat içinde biten antrenmanları doldurur, daha eskilerine dokunmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限最近两天。Body 只填写在过去 48 小时内结束的运动，更早的运动不会改动。"
          }
        }
      }
    },
