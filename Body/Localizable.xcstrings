{
  "sourceLanguage" : "en",
  "strings" : {
    "Auto-Apply Needs Permission" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Apply Needs Permission"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动填写需要权限"
          }
        }
      }
    },
    "Auto-Apply needs permission to update Workouts in Apple Health. Allow it in Settings › Health › Data Access & Devices › Body, then switch Auto-Apply back on." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Apply needs permission to update Workouts in Apple Health. Allow it in Settings › Health › Data Access & Devices › Body, then switch Auto-Apply back on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动填写需要更新运动数据的权限。请前往设置 › 健康 › 数据访问与设备 › Body 中允许后，再重新开启自动填写。"
          }
        }
      }
    },
    "About an hour after a workout ends. Body waits so a rating from your Apple Watch has time to sync first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About an hour after a workout ends. Body waits so a rating from your Apple Watch has time to sync first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动结束约一小时后。Body 会先等待，好让 Apple Watch 的评分有时间先同步过来。"
          }
        }
      }
    },
    "Only the past 2 days. Body fills workouts that ended within the last 48 hours and leaves older ones alone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the past 2 days. Body fills workouts that ended within the last 48 hours and leaves older ones alone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限最近两天。Body 只填写在过去 48 小时内结束的运动，更早的运动不会改动。"
          }
        }
      }
    },
    "When on, Body fills in effort for you, but only when it's confident. Some workouts get filled and others are left for you to rate:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, Body fills in effort for you, but only when it's confident. Some workouts get filled and others are left for you to rate:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，Body 会替你填写强度，但只在足够有把握时才填写。有些运动会被自动填写，有些则留给你自己评分："
          }
        }
      }
    },
    "Unrated only. Body never changes an effort you or your Apple Watch already set." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrated only. Body never changes an effort you or your Apple Watch already set."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限未评分：Body 绝不会改动你或你的 Apple Watch 已设置的强度。"
          }
        }
      }
    },
    "Enough data. Only workouts with heart-rate data get a prediction; sessions without heart rate stay blank for you to rate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enough data. Only workouts with heart-rate data get a prediction; sessions without heart rate stay blank for you to rate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据充足时：只有包含心率数据的运动才会获得预测；没有心率的运动会留空，交由你评分。"
          }
        }
      }
    },
    "Auto-Apply Effort" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Apply Effort"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动填写强度"
          }
        }
      }
    },
    "Save predictions to unrated workouts" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save predictions to unrated workouts"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为未评分的运动保存预测强度"
          }
        }
      }
    },
    "Re-rate any workout anytime to override Body's value." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-rate any workout anytime to override Body's value."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时重新为任何运动评分，以覆盖 Body 填写的数值。"
          }
        }
      }
    },
