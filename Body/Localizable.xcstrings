    "updateOnboarding.settings.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body lädt die letzten drei Monate und deine Übersicht neu aus Health und schreibt den lokalen Cache neu. Dein aufgezeichneter Tagesform-Verlauf bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reloads the last three months and your dashboard from Apple Health and rewrites the local cache. Your recorded readiness history is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body vuelve a cargar los últimos tres meses y tu panel desde la app Salud y reescribe la caché local. Se conserva tu historial de preparación registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body recharge les trois derniers mois et votre tableau de bord depuis l’app Santé et réécrit le cache local. L’historique de préparation enregistré est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body पिछले तीन महीनों का डेटा और आपका डैशबोर्ड सेहत से दोबारा लोड करता है और लोकल कैश दोबारा लिखता है। आपकी दर्ज रेडिनेस का इतिहास बना रहता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body заново загружает данные за последние три месяца и Вашу панель из приложения «Здоровье» и перезаписывает локальный кэш. Записанная история готовности сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body, son üç ayın verilerini ve panonuzu Sağlık uygulamasından yeniden yükler ve yerel önbelleği yeniden yazar. Kaydedilmiş hazırlık geçmişiniz korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会从 Apple 健康重新载入最近三个月的数据和你的仪表板，并重写本地缓存。你已记录的恢复状态历史会保留。"
          }
        }
      }
    },
