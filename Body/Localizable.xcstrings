    "notifications.permission.explainer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Body, dich über Messwertwarnungen, Phasen mit hohem Stress, synchronisierte Trainings und Schlafdaten zu informieren. Du kannst jede Kategorie in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Body to notify you about metric warnings, high-stress episodes, synced workouts, and sleep data. You can change each category in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Body te avise de alertas de métricas, episodios de estrés alto, entrenamientos sincronizados y datos de sueño. Puedes cambiar cada categoría en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Body à vous prévenir des avertissements de mesures, des épisodes de stress élevé, des exercices synchronisés et des données de sommeil. Vous pouvez modifier chaque catégorie dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body को मेट्रिक चेतावनियों, ज़्यादा तनाव के दौर, सिंक हुए वर्कआउट और नींद डेटा के बारे में सूचित करने की अनुमति दें। आप हर श्रेणी को सेटिंग में बदल सकते हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Body уведомлять Вас о предупреждениях о показателях, периодах высокого стресса, синхронизированных тренировках и данных сна. Каждую категорию можно изменить в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body'nin ölçüm uyarıları, yüksek stres dönemleri, eşzamanlanan antrenmanlar ve uyku verileri hakkında size bildirim göndermesine izin verin. Her kategoriyi Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Body 发送指标预警、高压力时段、运动同步和睡眠数据通知。您可以在设置中分别调整各类通知。"
          }
        }
      }
    },
