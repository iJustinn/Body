    "onboarding.effort.suggest.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Anstrengungsvorschläge“ aktiviert ist, schätzt Body für jedes Training eine Anstrengung anhand von Trainings- und Herzfrequenzdaten, deinem jüngsten Verlauf und deiner Tagesform."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Effort Suggestions on, Body estimates an effort for each workout from workout, heart rate, recent history, and readiness data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Sugerencias de esfuerzo activado, Body estima el esfuerzo de cada entrenamiento a partir de los datos del entrenamiento, la frecuencia cardiaca, el historial reciente y la preparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque les suggestions d’effort sont activées, Body estime un effort pour chaque exercice à partir des données de l’exercice, de la fréquence cardiaque, de l’historique récent et du niveau de préparation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रयास सुझाव चालू होने पर Body वर्कआउट, हृदय गति, हाल के इतिहास और रेडिनेस डेटा से हर वर्कआउट के प्रयास का अनुमान लगाता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если «Предлагаемое усилие» включено, Body оценивает усилие для каждой тренировки по данным тренировки, пульса, недавней истории и готовности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efor Önerileri açıkken Body; antrenman, kalp atış hızı, yakın geçmiş ve hazırlık verilerinden her antrenman için bir efor tahmini yapar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“强度建议”后，Body 会根据运动数据、心率、近期历史和就绪状态为每次运动估算强度。"
          }
        }
      }
    },
