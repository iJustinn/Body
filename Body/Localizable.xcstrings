    "onboarding.effort.yours.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Bewertung, die du sicherst, ersetzt den Vorschlag, und übernommene Vorschläge, die du nie geändert hast, fließen nicht in künftige Kalibrierungen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rating you save replaces the suggestion, and accepted suggestions you never changed are left out of future calibration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una valoración que guardes reemplaza a la sugerencia, y las sugerencias aceptadas que nunca cambiaste quedan fuera de la calibración futura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note que vous enregistrez remplace la suggestion, et les suggestions acceptées sans modification sont exclues des futurs étalonnages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सहेजी गई रेटिंग सुझाव की जगह ले लेती है, और जिन सुझावों को आपने बिना बदले स्वीकार किया, उन्हें आगे के कैलिब्रेशन में शामिल नहीं किया जाता।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраненная Вами оценка заменяет предложение, а принятые без изменений предложения не учитываются при дальнейшей калибровке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydettiğiniz puan önerinin yerini alır. Hiç değiştirmeden kabul ettiğiniz öneriler gelecekteki kalibrasyona dahil edilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您保存的评分会覆盖建议值；未经修改直接接受的建议不会用于后续校准。"
          }
        }
      }
    },
