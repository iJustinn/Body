    "About an hour after a workout ends. Body waits so a rating from your Apple Watch has time to sync first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa eine Stunde nach Trainingsende. Body wartet, damit eine Bewertung von deiner Apple Watch zuerst synchronisiert werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About an hour after a workout ends. Body waits so a rating from your Apple Watch has time to sync first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproximadamente una hora después de terminar un entrenamiento. Body espera para que la valoración de tu Apple Watch tenga tiempo de sincronizarse antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ une heure après la fin d’un exercice. Body attend pour que l’évaluation faite sur votre Apple Watch ait le temps de se synchroniser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्कआउट ख़त्म होने के लगभग एक घंटे बाद। Body इंतज़ार करता है, ताकि आपकी Apple Watch की रेटिंग को पहले सिंक होने का समय मिल जाए।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примерно через час после окончания тренировки. Body ждет, чтобы оценка с Apple Watch успела синхронизироваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman bittikten yaklaşık bir saat sonra. Body, Apple Watch'unuzdaki efor puanının önce eşzamanlanabilmesi için bekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动结束约一小时后。Body 会先等待，好让 Apple Watch 的评分有时间先同步过来。"
          }
        }
      }
    },
