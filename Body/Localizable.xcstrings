    "onboarding.welcome.privacy.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads Apple Health on device and keeps everything there. There is no account, no server of ours, and no tracking, so your health data is never uploaded anywhere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 在设备本地读取 Apple 健康数据，并将全部内容保留在本地。没有账户，没有我们的服务器，也没有任何追踪，您的健康数据不会被上传到任何地方。"
          }
        }
      }
    },
