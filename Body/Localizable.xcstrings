            "value" : "锻炼后的恢复"
          }
        }
      }
    },
    "stressUpdate.feature.windows.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Zeitfenster, in denen du dich tatsächlich bewegt hast, werden als Aktivität ausgeklammert, nicht die ganze Stunde darum herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the windows you actually moved in are set aside as Activity, not the whole hour around them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los intervalos en los que realmente te moviste se apartan como Actividad, no toda la hora a su alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les périodes où vous avez réellement bougé sont mises de côté comme activité, et non toute l’heure qui les entoure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ वही अंतराल ऐक्टिविटी के रूप में अलग रखे जाते हैं जिनमें आप सच में हिले डुले, उनके आसपास का पूरा घंटा नहीं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К активности относятся только промежутки, когда Вы действительно двигались, а не весь час вокруг них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevresindeki saatin tamamı değil, yalnızca gerçekten hareket ettiğiniz aralıklar Aktivite olarak ayrılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你真正在活动的时段才会归为活动，不再连带前后整个小时。"
          }
        }
      }
    },
    "stressUpdate.feature.windows.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr von deinem Tag bewertet"
          }
        },
        "en" : {
