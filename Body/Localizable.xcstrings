    "onboarding.trainingLoad.direction.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A load that climbs quickly means you are adding strain faster than your baseline can absorb. A falling load means recent training has eased off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷快速上升，说明您增加的强度超过了基准能够承受的范围；负荷下降则说明近期训练量有所放缓。"
          }
        }
      }
    },
    "onboarding.trainingLoad.range" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0.80 to 1.30 is the sustainable band"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0.80 到 1.30 是可持续区间"
          }
        }
      }
    },
    "onboarding.trainingLoad.range.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values in that band are usually the most sustainable. Staying above it for a while can point to a higher recovery demand."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处于该区间的数值通常最为可持续。长期高于该区间，可能意味着身体需要更多恢复。"
          }
        }
      }
    },
    "onboarding.trainingLoad.ratio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acute against chronic"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短期负荷对比长期负荷"
          }
        }
      }
    },
    "onboarding.trainingLoad.ratio.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acute load is a seven day exponentially weighted average of workout strain. Chronic load is a 42 day weighted average that reflects your adapted baseline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短期负荷是最近七天运动负荷的指数加权平均值，长期负荷则是 42 天的加权平均值，代表您已经适应的基准。"
          }
        }
      }
    },
