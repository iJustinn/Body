        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso cuando se sincronice un entrenamiento desde la app Salud. Toca la notificación para abrir sus detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification après la synchronisation d’un exercice depuis l’app Santé. Touchez la notification pour ouvrir ses détails."
