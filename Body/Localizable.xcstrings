          "stringUnit" : {
            "state" : "translated",
            "value" : "How your recent training compares with the training you are already used to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期的训练量与您已经适应的训练量之间的比较。"
