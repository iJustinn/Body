    "onboarding.effort.settingsHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Schalter findest du unter Einstellungen › Trainings › Anstrengungsvorschläge. „Automatisch übernehmen“ füllt nur unbewertete Trainings mit Herzfrequenzdaten aus, etwa eine Stunde nach ihrem Ende, und fragt beim Aktivieren nach der Berechtigung, Trainings in Health zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both switches live in Settings › Workouts › Effort Suggestions. Auto Apply only fills unrated workouts that have heart rate data, about an hour after they end, and asks to update Workouts in Apple Health when you turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos interruptores están en Ajustes › Entrenamientos › Sugerencias de esfuerzo. Esfuerzo automático solo completa los entrenamientos sin valorar que tienen datos de frecuencia cardiaca, aproximadamente una hora después de que terminen, y al activarlo pide permiso para actualizar los entrenamientos en la app Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux interrupteurs se trouvent dans Réglages › Exercices › Suggestions d’effort. L’application automatique ne remplit que les exercices non évalués qui comportent des données de fréquence cardiaque, environ une heure après leur fin, et demande l’autorisation de mettre à jour les exercices dans l’app Santé lorsque vous l’activez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों स्विच सेटिंग › वर्कआउट › प्रयास सुझाव में हैं। अपने आप लागू करने की सुविधा सिर्फ़ हृदय गति डेटा वाले बिना रेटिंग के वर्कआउट भरती है, उनके ख़त्म होने के लगभग एक घंटे बाद, और इसे चालू करने पर सेहत में वर्कआउट अपडेट करने की अनुमति माँगती है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба переключателя находятся в разделе «Настройки» › «Тренировки» › «Предлагаемое усилие». Автозаполнение оценивает только тренировки без оценки и с данными пульса, примерно через час после их окончания, и при включении запрашивает разрешение обновлять тренировки в приложении «Здоровье»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki anahtar da Ayarlar › Antrenmanlar › Efor Önerileri bölümündedir. Otomatik Uygula yalnızca kalp atış hızı verisi olan puanlanmamış antrenmanları, bittikten yaklaşık bir saat sonra doldurur ve açtığınızda Sağlık uygulamasında Antrenmanlar verisini güncellemek için izin ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这两个开关也可在设置›运动›强度建议中找到。自动应用只会填写带有心率数据且尚未评分的运动，大约在运动结束一小时后进行，开启时会请求更新 Apple 健康中的体能训练数据。"
          }
        }
      }
    },
    "onboarding.effort.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Bewertung von 1 bis 10 dafür, wie anstrengend sich jedes Training angefühlt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 1 to 10 rating for how hard each workout felt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una valoración del 1 al 10 de lo duro que te resultó cada entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note de 1 à 10 sur la difficulté ressentie de chaque exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर वर्कआउट कितना कठिन लगा, इसकी 1 से 10 तक की रेटिंग।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка от 1 до 10 того, насколько тяжелой показалась каждая тренировка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her antrenmanın ne kadar zor hissettirdiğini gösteren 1 ile 10 arası bir puan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 1 到 10 分记录每次运动的费力程度。"
          }
        }
      }
    },
