    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads workouts, workout routes, Activity Rings, sleep, heart rate, HRV, blood oxygen, respiratory rate, body measurements, energy, exercise minutes, skin temperature, daylight, steps, cardio fitness, power, cadence, swim strokes, distance, and date of birth from Apple Health to power your dashboard, charts, and widgets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 从健康 App 读取体能训练、训练路线、活动圆环、睡眠、心率、心率变异性、血氧、呼吸频率、身体测量值、能量、锻炼分钟数、皮肤温度、日照、步数、心肺适能、功率、步频、游泳划水次数、距离和出生日期，用于呈现你的仪表盘、图表和小组件。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body saves the weight, body fat, and workout effort ratings you enter to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会将你输入的体重、体脂率和体能训练强度评分保存到健康 App。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
