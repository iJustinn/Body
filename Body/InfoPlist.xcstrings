    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads workouts, workout routes, Activity Rings, sleep, heart rate, HRV, blood oxygen, respiratory rate, body measurements, energy, exercise minutes, skin temperature, daylight, steps, cardio fitness, power, cadence, swim strokes, distance, and date of birth from Apple Health to power your dashboard, charts, and widgets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 从健康 App 读取运动、训练路线、活动圆环、睡眠、心率、心率变异性、血氧、呼吸频率、身体测量值、能量、运动时长、皮肤温度、日照、步数、心肺适能、功率、步频、游泳划水次数、距离和出生日期，用于呈现你的仪表盘、图表和小组件。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body saves the weight, body fat, and workout effort ratings you enter to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会将你输入的体重、体脂率和运动强度评分保存到健康 App。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body saves the workout images you create to your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 会将你创建的运动图片保存到照片图库。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}