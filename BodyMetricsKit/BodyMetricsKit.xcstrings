        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद थोड़ी टूटी, लेकिन आपके रिकवरी सिग्नल अब भी बेहतरीन हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон был немного прерывистым, но сигналы восстановления по-прежнему отличные."
