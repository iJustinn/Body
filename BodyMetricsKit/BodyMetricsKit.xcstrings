    "Signals are mostly typical — readiness is decent, so keep the load controlled." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Signale sind größtenteils normal und deine Tagesform ist ordentlich. Halte die Belastung kontrolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signals are mostly typical — readiness is decent, so keep the load controlled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los indicadores están, en general, dentro de lo típico. Tu preparación es aceptable, así que mantén la carga controlada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signaux sont pour la plupart typiques et votre niveau de préparation est correct : gardez une charge maîtrisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिग्नल ज़्यादातर सामान्य हैं। रेडिनेस ठीक है, इसलिए लोड नियंत्रित रखें।"
