    "Breathing rate is a hair high, but nothing's holding you back. Prime to train." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Atemfrequenz ist eine Spur erhöht, aber nichts bremst dich. Du bist bereit fürs Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing rate is a hair high, but nothing's holding you back. Prime to train."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia respiratoria está ligeramente alta, pero nada te frena. Estás en excelente forma para entrenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence respiratoire est très légèrement élevée, mais rien ne vous freine. Conditions optimales pour vous entraîner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "श्वसन दर थोड़ी ज़्यादा है, लेकिन आपको कुछ भी नहीं रोक रहा। आप ट्रेनिंग के लिए बेहतरीन स्थिति में हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота дыхания немного повышена, но ничто Вас не сдерживает. Готовность отличная, можно тренироваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solunum hızınız bir tık yüksek ama sizi durduracak bir şey yok. Antrenmana tam hazırsınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸频率略偏高，但整体信号很强。今天可以正常训练。"
          }
        }
      }
    },
    "Breathing rate is above baseline. Readiness is moderate; keep it measured." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Atemfrequenz liegt über deinem Basiswert. Deine Tagesform ist moderat, trainiere mit Maß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing rate is above baseline. Readiness is moderate; keep it measured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia respiratoria está por encima de tu valor de referencia. Tu preparación es moderada; entrena con mesura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence respiratoire est au-dessus de votre référence. Votre niveau de préparation est modéré ; dosez vos efforts."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "श्वसन दर बेसलाइन से ऊपर है। रेडिनेस मध्यम है; संतुलित ट्रेनिंग करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота дыхания выше базового уровня. Готовность средняя, тренируйтесь умеренно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solunum hızınız referansın üstünde. Hazırlık orta düzeyde; ölçülü kalın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸频率高于基准。状态中等，训练量力而行。"
          }
        }
      }
    },
    "Breathing rate is slightly high, but you're well recovered. Normal training is fine." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Atemfrequenz ist leicht erhöht, aber du bist gut erholt. Normales Training ist in Ordnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathing rate is slightly high, but you're well recovered. Normal training is fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia respiratoria está algo alta, pero te has recuperado bien. Puedes entrenar con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence respiratoire est un peu élevée, mais votre récupération est bonne. Un entraînement normal convient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "श्वसन दर थोड़ी ज़्यादा है, लेकिन आप अच्छी तरह रिकवर हो चुके हैं। सामान्य ट्रेनिंग ठीक है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота дыхания немного повышена, но Вы хорошо восстановились. Обычная тренировка подойдет."
          }
        },
        "tr" : {
