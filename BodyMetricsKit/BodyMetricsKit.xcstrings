    "stress.band.rest" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peace"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
