    "Overnight breathing rate is elevated — a sign of extra load. Take it easy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine nächtliche Atemfrequenz ist erhöht, ein Zeichen für zusätzliche Belastung. Lass es ruhig angehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overnight breathing rate is elevated — a sign of extra load. Take it easy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia respiratoria nocturna está elevada, una señal de carga adicional. Tómatelo con calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fréquence respiratoire nocturne est élevée, signe d’une charge supplémentaire. Allez-y doucement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रात में श्वसन दर बढ़ी हुई है, जो अतिरिक्त लोड का संकेत है। आज आराम से रहें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночная частота дыхания повышена: это признак дополнительной нагрузки. Не перенапрягайтесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece boyunca solunum hızınız yüksekti; bu, ek yükün bir işareti. Bugün kendinizi zorlamayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜间呼吸频率偏高，可能代表身体负荷增加。今天放轻松些。"
          }
        }
      }
    },
