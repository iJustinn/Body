    "Blood Oxygen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blood Oxygen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
