    "Skin temperature is a little high, but recovery reads high. Train as planned." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hauttemperatur ist etwas erhöht, aber deine Erholung ist hoch. Trainiere wie geplant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin temperature is a little high, but recovery reads high. Train as planned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura de la piel está un poco alta, pero tu recuperación es buena. Entrena según lo previsto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre température cutanée est un peu élevée, mais votre récupération est bonne. Entraînez-vous comme prévu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्वचा का तापमान थोड़ा ज़्यादा है, लेकिन रिकवरी उच्च है। योजना के अनुसार ट्रेनिंग करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура кожи немного повышена, но восстановление хорошее. Тренируйтесь по плану."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilt sıcaklığı biraz yüksek ama toparlanma yüksek görünüyor. Planladığınız gibi antrenman yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤温度略偏高，但整体恢复不错。按计划训练即可。"
          }
        }
      }
    },
    "Skin temperature is a touch high, but recovery still reads prime." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hauttemperatur ist eine Spur erhöht, aber deine Erholung zeigt weiterhin Bestform."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin temperature is a touch high, but recovery still reads prime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura de la piel está algo alta, pero tu recuperación sigue siendo excelente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre température cutanée est légèrement élevée, mais votre récupération reste optimale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्वचा का तापमान थोड़ा ज़्यादा है, लेकिन रिकवरी अब भी बेहतरीन है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура кожи немного повышена, но восстановление по-прежнему отличное."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilt sıcaklığı bir tık yüksek ama toparlanma hâlâ zirvede görünüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤温度略偏高，但整体恢复依然很好。"
          }
        }
      }
    },
    "Skin temperature is above baseline — often an early strain or illness cue. Keep it light." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hauttemperatur liegt über deinem Basiswert, oft ein frühes Zeichen für Belastung oder Krankheit. Trainiere leicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin temperature is above baseline — often an early strain or illness cue. Keep it light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura de la piel está por encima de tu valor de referencia, a menudo una señal temprana de sobrecarga o enfermedad. Haz algo suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre température cutanée est au-dessus de votre référence, souvent un signe précoce de sollicitation ou de maladie. Optez pour une séance légère."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्वचा का तापमान बेसलाइन से ऊपर है, जो अक्सर शरीर पर दबाव या बीमारी का शुरुआती संकेत होता है। हल्की ऐक्टिविटी करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Температура кожи выше базового уровня: часто это ранний признак перегрузки или болезни. Тренируйтесь легко."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilt sıcaklığı referansın üstünde; bu, çoğu zaman zorlanmanın veya hastalığın erken bir işaretidir. Hafif tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮肤温度高于基准，可能是劳累或身体不适的早期信号。今天保持低强度。"
          }
        }
      }
    },
    "Skin temperature is above baseline, often an early strain or illness cue. Keep it light." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hauttemperatur liegt über deinem Basiswert, oft ein frühes Zeichen für Belastung oder Krankheit. Trainiere leicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skin temperature is above baseline, often an early strain or illness cue. Keep it light."
