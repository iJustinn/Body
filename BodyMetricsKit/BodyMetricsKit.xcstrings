    "Recent training load has piled up and readiness is paying for it. Favor recovery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Trainingsbelastung hat sich zuletzt angestaut und deine Tagesform leidet darunter. Setz auf Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent training load has piled up and readiness is paying for it. Favor recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de entrenamiento reciente se ha acumulado y tu preparación lo está pagando. Prioriza la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge d’entraînement récente s’est accumulée et votre niveau de préparation en pâtit. Privilégiez la récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल में ट्रेनिंग लोड काफ़ी जमा हो गया है और इसका असर रेडिनेस पर पड़ रहा है। रिकवरी को प्राथमिकता दें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавняя тренировочная нагрузка накопилась, и это сказывается на готовности. Отдайте предпочтение восстановлению."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son antrenman yükü birikti ve hazırlığınız bundan etkileniyor. Toparlanmaya öncelik verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期训练负荷累积较多，已经影响到今天的状态。建议以恢复为主。"
          }
        }
      }
    },
    "Recent work is climbing faster than your baseline. Space out hard days and watch recovery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Trainingsumfang steigt zuletzt schneller als dein Basiswert. Verteile harte Tage und achte auf deine Erholung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent work is climbing faster than your baseline. Space out hard days and watch recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu trabajo reciente sube más rápido que tu valor de referencia. Espacia los días intensos y vigila la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre volume récent augmente plus vite que votre référence. Espacez les journées intenses et surveillez votre récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की मेहनत आपकी बेसलाइन से तेज़ी से बढ़ रही है। कठिन दिनों के बीच अंतर रखें और रिकवरी पर नज़र रखें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавний объем тренировок растет быстрее Вашего базового уровня. Делайте перерывы между тяжелыми днями и следите за восстановлением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son çalışmalarınız referansınızdan daha hızlı artıyor. Zorlu günleri aralıklı planlayın ve toparlanmanızı izleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期训练量的上升快于你的基准。注意拉开高强度训练的间隔并关注恢复。"
          }
        }
      }
    },
    "Recent work is well above your baseline. Ease back before strain outpaces recovery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Trainingsumfang liegt zuletzt deutlich über deinem Basiswert. Fahr zurück, bevor die Belastung deine Erholung überholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent work is well above your baseline. Ease back before strain outpaces recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu trabajo reciente está muy por encima de tu valor de referencia. Baja el ritmo antes de que la sobrecarga supere a la recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre volume récent est nettement au-dessus de votre référence. Levez le pied avant que la sollicitation ne dépasse votre récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की मेहनत आपकी बेसलाइन से काफ़ी ऊपर है। शरीर पर दबाव रिकवरी से आगे निकल जाए, उससे पहले थोड़ा कम करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавний объем тренировок значительно выше Вашего базового уровня. Снизьте нагрузку, пока она не опередила восстановление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son çalışmalarınız referansınızın epey üstünde. Zorlanma toparlanmanızın önüne geçmeden yükü azaltın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期训练量远高于你的基准。适当减量，以免负荷超过恢复能力。"
          }
        }
      }
    },
    "Recent work sits below your baseline. Good for recovery, or a sign training has tapered off." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Trainingsumfang liegt zuletzt unter deinem Basiswert. Gut für die Erholung oder ein Zeichen, dass dein Training nachgelassen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent work sits below your baseline. Good for recovery, or a sign training has tapered off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu trabajo reciente está por debajo de tu valor de referencia. Es bueno para recuperarte, o una señal de que el entrenamiento ha disminuido."
