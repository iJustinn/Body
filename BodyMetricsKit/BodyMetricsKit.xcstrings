    "A light activity today nudged your readiness down a little, but it's still high. Train as planned." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leichte Aktivität heute hat deine Tagesform etwas gesenkt, sie ist aber weiterhin hoch. Trainiere wie geplant."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A light activity today nudged your readiness down a little, but it's still high. Train as planned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una actividad ligera de hoy bajó un poco tu preparación, pero sigue alta. Entrena según lo previsto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une activité légère aujourd’hui a fait un peu baisser votre niveau de préparation, mais il reste élevé. Entraînez-vous comme prévu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज की हल्की ऐक्टिविटी से आपकी रेडिनेस थोड़ी कम हुई है, लेकिन यह अब भी उच्च है। योजना के अनुसार ट्रेनिंग करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легкая активность сегодня немного снизила готовность, но она по-прежнему хорошая. Тренируйтесь по плану."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü hafif bir aktivite hazırlığınızı biraz düşürdü ama hâlâ yüksek. Planladığınız gibi antrenman yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的轻度活动让状态略有下降，但状态依然良好，可按计划训练。"
          }
        }
      }
    },
