    "Training load is up and you're handling it well — readiness stays high." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Trainingsbelastung ist gestiegen und du verkraftest sie gut. Deine Tagesform bleibt hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training load is up and you're handling it well — readiness stays high."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de entrenamiento ha subido y la estás llevando bien. Tu preparación sigue alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge d’entraînement augmente et vous l’encaissez bien. Votre niveau de préparation reste élevé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रेनिंग लोड बढ़ा है और आप इसे अच्छी तरह संभाल रहे हैं। रेडिनेस उच्च बनी हुई है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировочная нагрузка растет, и Вы хорошо с ней справляетесь. Готовность остается хорошей."
