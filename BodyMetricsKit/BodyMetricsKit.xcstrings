    "Short sleep last night is the main drag on today's readiness." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu wenig Schlaf letzte Nacht bremst deine heutige Tagesform am stärksten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short sleep last night is the main drag on today's readiness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haber dormido poco anoche es lo que más frena tu preparación de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre courte nuit est le principal frein à votre niveau de préparation aujourd’hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीती रात की कम नींद आज की रेडिनेस को सबसे ज़्यादा नीचे खींच रही है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткий сон прошлой ночью сильнее всего снижает сегодняшнюю готовность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü hazırlığınızı aşağı çeken asıl etken dün geceki kısa uyku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚睡眠不足，是今天状态偏低的主要原因。"
          }
        }
      }
    },
    "Signals are mixed but nothing stands out — readiness is simply low today. Favor easy work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Signale sind gemischt, aber nichts sticht heraus. Deine Tagesform ist heute einfach niedrig. Setz auf leichtes Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signals are mixed but nothing stands out — readiness is simply low today. Favor easy work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los indicadores son dispares, pero ninguno destaca. Tu preparación simplemente está baja hoy. Prioriza el trabajo suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signaux sont contrastés sans qu’aucun ne ressorte : votre niveau de préparation est simplement faible aujourd’hui. Privilégiez les séances faciles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिग्नल मिले जुले हैं, लेकिन कोई एक अलग से नहीं दिखता। आज रेडिनेस बस कम है। हल्की ट्रेनिंग को प्राथमिकता दें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы неоднозначны, но ничто особо не выделяется: просто сегодня готовность низкая. Отдайте предпочтение легкой нагрузке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinyaller karışık ama öne çıkan bir şey yok. Hazırlık bugün genel olarak düşük. Hafif çalışmayı tercih edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各项信号有些波动，但没有单一突出原因。今天状态偏低，适合轻松一点。"
          }
        }
      }
    },
