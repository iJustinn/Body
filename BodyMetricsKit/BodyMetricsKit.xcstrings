    "HRV is running below baseline — readiness is okay, but keep the load controlled." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV liegt unter deinem Basiswert. Deine Tagesform ist in Ordnung, halte die Belastung aber kontrolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is running below baseline — readiness is okay, but keep the load controlled."
