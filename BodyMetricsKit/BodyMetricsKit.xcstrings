    "Only a light activity today, so your low readiness mainly reflects your recovery signals, not training." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute nur eine leichte Aktivität, deine niedrige Tagesform spiegelt also vor allem deine Erholungssignale wider, nicht dein Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a light activity today, so your low readiness mainly reflects your recovery signals, not training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy solo hubo actividad ligera, así que tu preparación baja refleja sobre todo tus indicadores de recuperación, no el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement une activité légère aujourd’hui : votre niveau de préparation faible reflète donc surtout vos signaux de récupération, pas l’entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज सिर्फ़ हल्की ऐक्टिविटी हुई, इसलिए आपकी कम रेडिनेस मुख्य रूप से ट्रेनिंग नहीं, बल्कि आपके रिकवरी सिग्नल को दिखाती है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня была только легкая активность, поэтому низкая готовность в основном отражает сигналы восстановления, а не тренировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün yalnızca hafif bir aktivite yaptınız; bu yüzden düşük hazırlığınız antrenmanı değil, büyük ölçüde toparlanma sinyallerinizi yansıtıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天只是轻度活动，偏低的状态主要来自身体的恢复信号，而非训练。"
          }
        }
      }
    },
