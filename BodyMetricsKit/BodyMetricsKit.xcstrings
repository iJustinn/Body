    "Badly broken sleep has left you short on recovery. Keep it very light or rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stark unterbrochener Schlaf hat dir Erholung gekostet. Trainiere nur sehr leicht oder ruh dich aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badly broken sleep has left you short on recovery. Keep it very light or rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sueño muy interrumpido te ha dejado con poca recuperación. Haz algo muy suave o descansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sommeil très fragmenté a limité votre récupération. Optez pour une séance très légère ou reposez-vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार बार टूटी नींद के कारण आपकी रिकवरी अधूरी रह गई है। बहुत हल्की ऐक्टिविटी करें या आराम करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильно прерывистый сон не дал Вам восстановиться. Сделайте тренировку очень легкой или отдохните."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sık sık bölünen uyku toparlanmanızı eksik bıraktı. Çok hafif tutun ya da dinlenin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚睡眠质量偏低，身体恢复不足。建议休息，或做些轻松的运动。"
          }
        }
      }
    },
    "Badly broken sleep has left you under-recovered. Keep it very light or rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach stark unterbrochenem Schlaf bist du nicht ausreichend erholt. Trainiere nur sehr leicht oder ruh dich aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Badly broken sleep has left you under-recovered. Keep it very light or rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sueño muy interrumpido no te ha dejado recuperarte bien. Haz algo muy suave o descansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sommeil très fragmenté n’a pas permis une récupération suffisante. Optez pour une séance très légère ou reposez-vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बार बार टूटी नींद के कारण आपका शरीर पूरी तरह रिकवर नहीं हुआ है। बहुत हल्की ऐक्टिविटी करें या आराम करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из-за сильно прерывистого сна Вы не восстановились. Тренируйтесь очень легко или отдохните."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sık sık bölünen uyku nedeniyle yeterince toparlanamadınız. Çok hafif tutun ya da dinlenin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚睡眠质量偏低，身体恢复不足。建议休息，或做些轻松的运动。"
          }
        }
      }
    },
