          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos básicos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensu­ra­tions"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुनियादी माप"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изме­ре­ния тела"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel Veriler"
          }
