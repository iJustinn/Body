        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы в основном в норме, готовность неплохая, поэтому держите нагрузку под контролем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinyaller büyük ölçüde normal. Hazırlık idare eder, bu yüzden yükü kontrollü tutun."
