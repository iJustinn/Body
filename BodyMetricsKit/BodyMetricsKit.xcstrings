    "Multiple signals are down together — readiness is poor. Rest or keep it very light." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Signale sind gleichzeitig gesunken und deine Tagesform ist schwach. Ruh dich aus oder trainiere nur sehr leicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiple signals are down together — readiness is poor. Rest or keep it very light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios indicadores han bajado a la vez y tu preparación es muy baja. Descansa o haz algo muy suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs signaux baissent en même temps et votre niveau de préparation est insuffisant. Reposez-vous ou optez pour une séance très légère."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई सिग्नल एक साथ नीचे हैं और रेडिनेस ख़राब है। आराम करें या बहुत हल्की ऐक्टिविटी करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько сигналов снизились одновременно, готовность плохая. Отдохните или тренируйтесь очень легко."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla sinyal aynı anda düşük ve hazırlık zayıf. Dinlenin ya da çok hafif tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多项信号同时走低，今天状态较差。建议休息，或只做很轻松的活动。"
          }
        }
      }
    },
