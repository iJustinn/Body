        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल की मेहनत आपकी बेसलाइन से कम है। यह रिकवरी के लिए अच्छा है, या इस बात का संकेत है कि ट्रेनिंग कम हो गई है।"
