            "value" : "基础数据"
          }
        }
      }
    },
    "Basics tracks weight, body fat, and BMI together so changes are easier to compare in context. Daily movement can reflect hydration, meals, measurement timing, or device differences. Longer trends are usually more useful than single readings." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basics tracks weight, body fat, and BMI together so changes are easier to compare in context. Daily movement can reflect hydration, meals, measurement timing, or device differences. Longer trends are usually more useful than single readings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础数据将体重、体脂率和体重指数放在一起追踪，便于在同一背景下比较变化。每日波动可能反映水分、饮食、测量时间或设备差异。长期趋势通常比单次读数更有参考价值。"
          }
        }
      }
    },
    "Basketball" : {
