    "Recent load is elevated — readiness is moderate, so manage the intensity." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine jüngste Belastung ist erhöht und deine Tagesform moderat. Dosiere die Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent load is elevated — readiness is moderate, so manage the intensity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga reciente es elevada y tu preparación es moderada, así que dosifica la intensidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre charge récente est élevée et votre niveau de préparation est modéré : dosez l’intensité."
