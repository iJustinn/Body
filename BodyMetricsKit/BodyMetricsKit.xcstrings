    "Basics" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körper­mess­werte"
          }
        },
        "en" : {
          "stringUnit" : {
