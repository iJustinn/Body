    "HRV is well below baseline — your body needs recovery. Rest or keep it very light." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV liegt deutlich unter deinem Basiswert und dein Körper braucht Erholung. Ruh dich aus oder trainiere nur sehr leicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is well below baseline — your body needs recovery. Rest or keep it very light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VFC está muy por debajo de tu valor de referencia y tu cuerpo necesita recuperarse. Descansa o haz algo muy suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC est nettement sous votre référence et votre corps a besoin de récupérer. Reposez-vous ou optez pour une séance très légère."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV बेसलाइन से काफ़ी कम है और आपके शरीर को रिकवरी की ज़रूरत है। आराम करें या बहुत हल्की ऐक्टिविटी करें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ВСР значительно ниже базового уровня, организму нужно восстановление. Отдохните или тренируйтесь очень легко."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV referansın epey altında ve vücudunuzun toparlanmaya ihtiyacı var. Dinlenin ya da çok hafif tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率变异性远低于基准，身体需要恢复。建议休息，或只做很轻松的活动。"
          }
        }
      }
    },
