        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议休息或保持极低强度，等待信号回升。"
          }
        }
      }
    },
    "Resting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting"
