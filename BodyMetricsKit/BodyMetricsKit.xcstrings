    "HRV is a little under baseline, but recovery is solid. Normal training is fine." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV liegt etwas unter deinem Basiswert, aber deine Erholung ist solide. Normales Training ist in Ordnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV is a little under baseline, but recovery is solid. Normal training is fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VFC está un poco por debajo de tu valor de referencia, pero la recuperación es sólida. Puedes entrenar con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre VFC est un peu sous votre référence, mais votre récupération est solide. Un entraînement normal convient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV बेसलाइन से थोड़ी कम है, लेकिन रिकवरी अच्छी है। सामान्य ट्रेनिंग ठीक है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ВСР немного ниже базового уровня, но восстановление хорошее. Обычная тренировка подойдет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV referansın biraz altında ama toparlanma sağlam. Normal antrenman yapabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率变异性略低于基准，但整体恢复不错。可以正常训练。"
          }
        }
      }
    },
