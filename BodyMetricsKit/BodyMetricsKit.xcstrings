    "Sleep ran a little short, yet recovery still landed in the prime range." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlaf war etwas kurz, deine Erholung liegt aber trotzdem im Bestform-Bereich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep ran a little short, yet recovery still landed in the prime range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormiste un poco menos de lo ideal, pero tu recuperación sigue en el rango excelente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nuit a été un peu courte, mais votre récupération reste dans la zone optimale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद थोड़ी कम रही, फिर भी रिकवरी बेहतरीन रेंज में रही।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сна было немного меньше, но восстановление все равно на отличном уровне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku biraz kısa kaldı ama toparlanma yine de zirve aralığına ulaştı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚睡得稍短，但整体恢复依然很好。"
          }
        }
      }
    },
    "Sleep was a bit broken, but your recovery signals still read prime." : {
