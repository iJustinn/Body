    "Time in Daylight" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit im Tageslicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time in Daylight"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo con luz diurna"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumière du jour"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन की रोशनी में समय"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время при дневном свете"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün Işığında Süre"
          }
        },
        "zh-Hans" : {
