    "Every signal is on or above baseline — you're primed for your hardest training." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Signal liegt auf oder über deinem Basiswert. Du bist bereit für dein härtestes Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every signal is on or above baseline — you're primed for your hardest training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los indicadores están en tu valor de referencia o por encima. Es un buen día para tu entrenamiento más exigente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les signaux sont au niveau de votre référence ou au-dessus. Vous êtes en condition pour vos entraînements les plus intenses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सिग्नल बेसलाइन पर या उससे बेहतर है। आप अपनी सबसे कठिन ट्रेनिंग के लिए पूरी तरह तैयार हैं।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сигналы на базовом уровне или выше. Вы готовы к самой тяжелой тренировке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sinyal referans düzeyinde ya da üstünde. En zorlu antrenmanınıza tam hazırsınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各项信号都在基准或更好。今天可以挑战高强度训练。"
          }
        }
      }
    },
