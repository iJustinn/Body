    "A click when you tap refresh and a tap when it finishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick, wenn du auf „Aktualisieren“ tippst, und ein Tippen, wenn es fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A click when you tap refresh and a tap when it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic al tocar Actualizar y un toque al terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic lorsque vous touchez « Actualiser », puis un tapotement une fois terminé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीफ़्रेश पर टैप करने पर एक क्लिक, और रीफ़्रेश पूरा होने पर एक टैप।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелчок при касании кнопки обновления и легкий отклик по завершении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilemeye dokunduğunuzda bir tık, yenileme bittiğinde hafif bir dokunuş."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点刷新时和刷新完成时各震动一下。"
          }
        }
      }
    },
    "A periodic check found a blood oxygen level of %lld%% today, below your %lld%% limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine regelmäßige Messung hat heute einen Blutsauerstoffwert von %lld%% ergeben, unter deinem Grenzwert von %lld%%."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A periodic check found a blood oxygen level of %lld%% today, below your %lld%% limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comprobación periódica detectó hoy un nivel de oxígeno en sangre del %lld%%, por debajo de tu límite del %lld%%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vérification périodique a relevé aujourd’hui un taux d’oxygène sanguin de %lld %%, sous votre limite de %lld %%."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक नियमित जाँच में आज आपका रक्त ऑक्सीजन स्तर %lld%% पाया गया, जो आपकी %lld%% की सीमा से कम है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При плановой проверке сегодня уровень кислорода в крови составил %lld%%, это ниже Вашего порога (%lld%%)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenli kontrolde bugün kanda oksijen düzeyiniz %%%lld ölçüldü. Bu değer, belirlediğiniz %%%lld sınırının altında."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期检查发现今天的血氧水平为 %lld%%，低于您设定的 %lld%% 限值。"
          }
        }
      }
    },
