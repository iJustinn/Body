        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du trainiert hast, verschwindet diese Warnung, sobald das Training erfasst ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you were working out, this warning will disappear once the workout is logged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si estabas entrenando, este aviso desaparecerá cuando se registre el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous faisiez de l’exercice, cet avertissement disparaîtra une fois l’exercice enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप उस समय वर्कआउट कर रहे थे, तो वर्कआउट लॉग होते ही यह चेतावनी हट जाएगी।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если Вы тренировались, это предупреждение исчезнет, как только тренировка будет записана."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman yapıyorduysanız bu uyarı, antrenman kaydedildiğinde kaybolur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您当时正在体能训练，该警告会在训练记录同步后消失。"
          }
        }
      }
    },
