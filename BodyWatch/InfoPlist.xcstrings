    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads heart rate and heart rate variability from Apple Health on your Apple Watch to refresh those readings when your iPhone isn't nearby."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 在你的 Apple Watch 上从健康 App 读取心率和心率变异性，以便在 iPhone 不在附近时更新这些数据。"
          }
        }
      }
    },
