    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body reads workouts, workout effort, sleep, heart rate, resting heart rate, HRV, respiratory rate, blood oxygen, and skin temperature from Apple Health on your Apple Watch so it can update your metrics on your wrist when your iPhone isn't nearby."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 在你的 Apple Watch 上从健康 App 读取锻炼、锻炼强度、睡眠、心率、静息心率、心率变异性、呼吸频率、血氧和皮肤温度，以便在 iPhone 不在附近时也能在手表上更新你的指标。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body does not write data to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body 不会向健康 App 写入数据。"
          }
        }
      }
    }
  },
  "version" : "1.0"
